# shellcheck shell=bash
############################################################################
# /etc/portage/bashrc
#
# Bash-only hooks for global-first performance experiments.
############################################################################

# Fail closed if any stale package.env assignment attempts to activate the
# legacy compiler-agnostic PGO paths.  Phase 2 replaces this file with an exact
# backend/ABI/fingerprint dispatcher; until then no profile mode is permitted.
if [[ "${PGO_INSTRUMENT:-0}" == "1" || "${PGO_USE_IF_AVAILABLE:-0}" == "1" ]]; then
    printf '%s\n' \
        'ERROR: legacy global PGO mode is disabled pending the exact backend-specific implementation' \
        >&2
    return 1
fi

# Deliberately no fallback implementation lives below this guard.  Phase 2
# installs the reviewed backend/ABI/fingerprint dispatcher as a replacement;
# until then this file must be incapable of adding optimization flags.
