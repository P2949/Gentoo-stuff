############################################################################
# /etc/portage/bashrc
#
# Bash-only hooks for global-first performance experiments.
############################################################################

_gentoo_stuff_pgo_profile_base() {
    local category="${CATEGORY:-unknown}"
    local package="${PN:-unknown}"

    printf '/var/tmp/pgo-profiles/%s/%s' "${category}" "${package}"
}

_gentoo_stuff_append_flags_once() {
    local var_name="$1"
    local flags="$2"
    local current="${!var_name:-}"

    if [[ " ${current} " == *" ${flags} "* ]]; then
        return
    fi

    if [[ -n "${current}" ]]; then
        printf -v "${var_name}" '%s %s' "${current}" "${flags}"
    else
        printf -v "${var_name}" '%s' "${flags}"
    fi
    export "${var_name}"
}

_gentoo_stuff_apply_pgo() {
    local profile_base
    profile_base="$(_gentoo_stuff_pgo_profile_base)"

    if [[ "${PGO_INSTRUMENT:-0}" == "1" ]]; then
        PGO_PROFILE_DIR="${profile_base}/raw"
        PGO_INSTRUMENT_FLAGS="-fprofile-generate=${PGO_PROFILE_DIR}"
        export PGO_PROFILE_DIR PGO_INSTRUMENT_FLAGS

        _gentoo_stuff_append_flags_once CFLAGS "${PGO_INSTRUMENT_FLAGS}"
        _gentoo_stuff_append_flags_once CXXFLAGS "${PGO_INSTRUMENT_FLAGS}"
        _gentoo_stuff_append_flags_once FCFLAGS "${PGO_INSTRUMENT_FLAGS}"
        _gentoo_stuff_append_flags_once FFLAGS "${PGO_INSTRUMENT_FLAGS}"
        _gentoo_stuff_append_flags_once LDFLAGS "${PGO_INSTRUMENT_FLAGS}"
        return
    fi

    if [[ "${PGO_USE_IF_AVAILABLE:-0}" != "1" || "${PGO_DISABLE_USE:-0}" == "1" ]]; then
        return
    fi

    PGO_PROFILE_DATA="${profile_base}/merged.profdata"
    export PGO_PROFILE_DATA

    if [[ ! -r "${PGO_PROFILE_DATA}" ]]; then
        return
    fi

    PGO_USE_FLAGS="-fprofile-use=${PGO_PROFILE_DATA} -fprofile-correction -Wno-error=profile-instr-out-of-date -Wno-error=profile-instr-unprofiled"
    export PGO_USE_FLAGS

    _gentoo_stuff_append_flags_once CFLAGS "${PGO_USE_FLAGS}"
    _gentoo_stuff_append_flags_once CXXFLAGS "${PGO_USE_FLAGS}"
    _gentoo_stuff_append_flags_once FCFLAGS "${PGO_USE_FLAGS}"
    _gentoo_stuff_append_flags_once FFLAGS "${PGO_USE_FLAGS}"
    _gentoo_stuff_append_flags_once LDFLAGS "-fprofile-use=${PGO_PROFILE_DATA}"
}

_gentoo_stuff_apply_pgo
