# shellcheck shell=bash
############################################################################
# /etc/portage/bashrc -- strict system-wide optimization mode dispatcher
############################################################################

# This file is sourced by Portage.  Active modes deliberately require an
# externally generated exact package fingerprint and explicit ABI/profile
# identity.  It never guesses a profile from CATEGORY/PN.

# Capture the one-shot production-gate authorization before any helper is
# launched, then remove every bearer/test value from the exported environment.
# These shell-only copies are cleared immediately after the coordinator has
# verified the active transaction.  In particular, no compiler, configure
# process, or framework helper inherits the raw bearer token.
gentoo_opt_profile_transaction_token=${GENTOO_OPT_PRODUCTION_PROFILE_TRANSACTION_TOKEN-}
gentoo_opt_profile_transaction_authorization=${GENTOO_OPT_PRODUCTION_PROFILE_TRANSACTION_AUTHORIZATION-}
if [[ -z ${gentoo_opt_profile_transaction_authorization} ]]; then
    gentoo_opt_profile_transaction_authorization_file=/var/lib/gentoo-optimization/state/profile-transactions/phase2-production-authorization.path
    if [[ -f ${gentoo_opt_profile_transaction_authorization_file} &&
        ! -L ${gentoo_opt_profile_transaction_authorization_file} ]]; then
        IFS= read -r gentoo_opt_profile_transaction_authorization < \
            "${gentoo_opt_profile_transaction_authorization_file}" || :
    fi
    unset gentoo_opt_profile_transaction_authorization_file
fi
if [[ -z ${gentoo_opt_profile_transaction_token} &&
    -n ${gentoo_opt_profile_transaction_authorization} &&
    ${gentoo_opt_profile_transaction_authorization} == /*/transaction.authorization ]]; then
    # Portage filters arbitrary environment variables before entering the
    # userpriv phase.  The coordinator therefore exposes the one-shot bearer
    # through this root-owned, portage-readable runtime file while the global
    # transaction locks exclude concurrent production gates.
    gentoo_opt_profile_transaction_token_file=/var/lib/gentoo-optimization/state/profile-transactions/phase2-production-token
    if [[ -f ${gentoo_opt_profile_transaction_token_file} &&
        ! -L ${gentoo_opt_profile_transaction_token_file} ]]; then
        IFS= read -r gentoo_opt_profile_transaction_token < \
            "${gentoo_opt_profile_transaction_token_file}" || :
    fi
    unset gentoo_opt_profile_transaction_token_file
fi
gentoo_opt_profile_transaction_test_root=${GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_ROOT-}
gentoo_opt_profile_transaction_test_framework_lock=${GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_FRAMEWORK_LOCK-}
gentoo_opt_profile_transaction_test_project_lock=${GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_PROJECT_LOCK-}
gentoo_opt_profile_transaction_test_generation_lock=${GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_GENERATION_LOCK-}
gentoo_opt_profile_transaction_test_journal=${GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_JOURNAL-}
gentoo_opt_profile_transaction_test_helper=${GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_HELPER-}
export -n gentoo_opt_profile_transaction_token \
    gentoo_opt_profile_transaction_authorization \
    gentoo_opt_profile_transaction_test_root \
    gentoo_opt_profile_transaction_test_framework_lock \
    gentoo_opt_profile_transaction_test_project_lock \
    gentoo_opt_profile_transaction_test_generation_lock \
    gentoo_opt_profile_transaction_test_journal \
    gentoo_opt_profile_transaction_test_helper
unset GENTOO_OPT_PRODUCTION_PROFILE_TRANSACTION_TOKEN \
    GENTOO_OPT_PRODUCTION_PROFILE_TRANSACTION_AUTHORIZATION \
    GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_ROOT \
    GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_FRAMEWORK_LOCK \
    GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_PROJECT_LOCK \
    GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_GENERATION_LOCK \
    GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_JOURNAL \
    GENTOO_OPT_TEST_PRODUCTION_PROFILE_TRANSACTION_HELPER

gentoo_opt_error() {
    printf 'gentoo-optimization: ERROR: %s\n' "$*" >&2
    return 1
}

gentoo_opt_abort() {
    local message=$1
    gentoo_opt_error "${message}" || :
    if declare -F die >/dev/null; then
        die "gentoo-optimization: ${message}"
    fi
    return 1
}

# GENTOO_OPT_FRAMEWORK_BINDING_PLACEHOLDER
# The root-owned installer replaces the marker above with four literal
# candidate-specific assignments.  A checkout-sourced bashrc is deliberately
# unbound: it is accepted only by the hermetic dispatcher fixture or before the
# first managed framework exists.  An installed bashrc pins every descendant
# helper/QA dispatch to the exact candidate whose policy was sourced, even if
# framework-current changes while a Portage process is still alive.
gentoo_opt_bind_framework_target() {
    local embedded=${gentoo_opt_embedded_framework_target-}
    local base=${gentoo_opt_embedded_framework_base-}
    local anchor=${gentoo_opt_embedded_framework_trust_anchor-}
    local expected_uid=${gentoo_opt_embedded_framework_expected_uid-}
    local existing=${GENTOO_OPT_FRAMEWORK_TARGET-}
    local identity component owner mode

    if [[ -z ${embedded} ]]; then
        if [[ ${GENTOO_OPT_DISPATCHER_TEST_MODE:-0} == 1 && -z ${EBUILD_PHASE-} ]]; then
            [[ -z ${existing} ]] || {
                gentoo_opt_abort 'an unbound dispatcher fixture inherited a framework target' || return 1
            }
            return 0
        fi
        if [[ ! -e /var/lib/gentoo-optimization/framework-current &&
            ! -L /var/lib/gentoo-optimization/framework-current ]]; then
            [[ -z ${existing} ]] || {
                gentoo_opt_abort 'legacy pre-activation policy inherited a framework target' || return 1
            }
            return 0
        fi
        gentoo_opt_abort 'unbound Portage policy is forbidden after framework activation' || return 1
    fi

    [[ ${base} == /* && ${base} != / && ${anchor} == /* &&
        ${expected_uid} =~ ^[0-9]+$ ]] || {
        gentoo_opt_abort 'installed framework binding metadata is malformed' || return 1
    }
    identity=${embedded#"${base}"/framework-}
    [[ ${embedded} == "${base}/framework-${identity}" &&
        ${identity} =~ ^[0-9a-f]{64}$ ]] || {
        gentoo_opt_abort 'installed framework target identity is malformed' || return 1
    }
    component=${embedded}
    while :; do
        [[ -d ${component} && ! -L ${component} ]] || {
            gentoo_opt_abort "installed framework trust path is unavailable: ${component}" || return 1
        }
        owner=$(/usr/bin/stat -c %u -- "${component}") || return 1
        mode=$(/usr/bin/stat -c %a -- "${component}") || return 1
        [[ ${owner} == "${expected_uid}" && ${mode} =~ ^[0-7]{3,4}$ ]] || {
            gentoo_opt_abort "installed framework trust path has an invalid identity: ${component}" || return 1
        }
        (( (8#${mode} & 8#022) == 0 )) || {
            gentoo_opt_abort "installed framework trust path is writable by an untrusted identity: ${component}" || return 1
        }
        [[ ${component} == "${anchor}" ]] && break
        if [[ ${anchor} == / ]]; then
            [[ ${component} == /* ]] || {
                gentoo_opt_abort 'installed framework target escapes its trust anchor' || return 1
            }
        else
            [[ ${component} == "${anchor}"/* ]] || {
                gentoo_opt_abort 'installed framework target escapes its trust anchor' || return 1
            }
        fi
        component=${component%/*}
        [[ -n ${component} ]] || component=/
    done
    [[ -f ${embedded}/portage/bashrc && ! -L ${embedded}/portage/bashrc ]] || {
        gentoo_opt_abort 'installed framework target lacks its regular Portage policy' || return 1
    }
    [[ -z ${existing} || ${existing} == "${embedded}" ]] || {
        gentoo_opt_abort \
            "Portage process attempted to cross framework generations (${existing} -> ${embedded})" || return 1
    }
    if [[ -z ${existing} ]]; then
        GENTOO_OPT_FRAMEWORK_TARGET=${embedded}
        export GENTOO_OPT_FRAMEWORK_TARGET
        readonly GENTOO_OPT_FRAMEWORK_TARGET
    fi
}

gentoo_opt_bind_framework_target || {
    if [[ ${BASH_SOURCE[0]} == "$0" ]]; then exit 1; fi
    return 1
}
unset -f gentoo_opt_bind_framework_target
unset gentoo_opt_embedded_framework_target gentoo_opt_embedded_framework_base \
    gentoo_opt_embedded_framework_trust_anchor gentoo_opt_embedded_framework_expected_uid

# The root-owned framework installer fsyncs this durable marker before its
# first publication mutation and removes it only after every current-generation
# entry point has passed verification.  Any filesystem object at the exact
# path is therefore a hard stop: after interruption, Portage must not start a
# build against a mixed framework while recovery is still pending.
gentoo_opt_framework_journal=/var/lib/gentoo-optimization/framework-activation.pending
gentoo_opt_framework_journals=("${gentoo_opt_framework_journal}")
if [[ -n ${GENTOO_OPT_TEST_FRAMEWORK_ACTIVATION_JOURNAL-} ]]; then
    if [[ ${GENTOO_OPT_DISPATCHER_TEST_MODE:-0} == 1 && -z ${EBUILD_PHASE-} &&
        ${GENTOO_OPT_TEST_FRAMEWORK_ACTIVATION_JOURNAL} == /* ]]; then
        # This is an additional hermetic marker; it can never replace or
        # suppress the exact production marker checked above.
        gentoo_opt_framework_journals+=(
            "${GENTOO_OPT_TEST_FRAMEWORK_ACTIVATION_JOURNAL}"
        )
    else
        gentoo_opt_abort 'framework activation journal overrides are forbidden' || {
            if [[ ${BASH_SOURCE[0]} == "$0" ]]; then exit 1; fi
            return 1
        }
    fi
fi
for gentoo_opt_framework_journal in "${gentoo_opt_framework_journals[@]}"; do
    if [[ -e ${gentoo_opt_framework_journal} || -L ${gentoo_opt_framework_journal} ]]; then
        gentoo_opt_abort \
            'framework activation is incomplete; rerun the root-owned installer before using Portage' || {
            if [[ ${BASH_SOURCE[0]} == "$0" ]]; then exit 1; fi
            return 1
        }
    fi
done
unset gentoo_opt_framework_journal gentoo_opt_framework_journals

gentoo_opt_safe_absolute_path() {
    local path=${1-}
    [[ ${path} == /* && ${path} != / && ${path} != *:* && ${path} != *//* && ${path} != *'/../'* &&
        ${path} != */.. && ${path} != *'/./'* && ${path} != */. &&
        ${path} != *[$'\n\r\t ']* ]]
}

# A root-only Phase 2 integration gate temporarily writes one exact generation
# payload into the stable project/generation lock inodes.  Its durable journal
# is a hard stop after SIGKILL or reboot.  The candidate-bound coordinator is
# the sole parser for its journal, child sidecar, authorization, framework, and
# lock identities; this Portage wrapper only selects the fixed production
# namespace or an explicit private fixture namespace.
gentoo_opt_validate_profile_transaction_guard() {
    local production_journal=/var/lib/gentoo-optimization/state/profile-transactions/phase-2-production-profile-locks.pending
    local journal=${production_journal}
    local token=${gentoo_opt_profile_transaction_token-}
    local authorization=${gentoo_opt_profile_transaction_authorization-}
    local test_root=${gentoo_opt_profile_transaction_test_root-}
    local test_framework=${gentoo_opt_profile_transaction_test_framework_lock-}
    local test_project=${gentoo_opt_profile_transaction_test_project_lock-}
    local test_generation=${gentoo_opt_profile_transaction_test_generation_lock-}
    local test_journal=${gentoo_opt_profile_transaction_test_journal-}
    local helper=/usr/local/libexec/gentoo-optimization/pgo/production-profile-lock-transaction.py
    local test_helper=${gentoo_opt_profile_transaction_test_helper-}
    local test_mode=0
    local -a helper_arguments=(verify-active)

    unset gentoo_opt_profile_transaction_token \
        gentoo_opt_profile_transaction_authorization \
        gentoo_opt_profile_transaction_test_root \
        gentoo_opt_profile_transaction_test_framework_lock \
        gentoo_opt_profile_transaction_test_project_lock \
        gentoo_opt_profile_transaction_test_generation_lock \
        gentoo_opt_profile_transaction_test_journal \
        gentoo_opt_profile_transaction_test_helper

    # These fixed production markers are never suppressible by fixture paths.
    if [[ -e ${production_journal}.partial || -L ${production_journal}.partial ||
        -e ${production_journal}.child.json.partial ||
        -L ${production_journal}.child.json.partial ]]; then
        gentoo_opt_error 'production profile-lock transaction publication is incomplete'
        return 1
    fi

    if [[ -n ${test_root}${test_framework}${test_project}${test_generation}${test_journal}${test_helper} ]]; then
        if [[ ${GENTOO_OPT_DISPATCHER_TEST_MODE:-0} != 1 || -n ${EBUILD_PHASE-} ||
            -z ${test_root} || -z ${test_framework} || -z ${test_project} ||
            -z ${test_generation} || -z ${test_journal} || -z ${test_helper} ||
            ${test_root} != /* || ${test_root} == / ||
            ${test_framework} != "${test_root}"/* ||
            ${test_project} != "${test_root}"/* ||
            ${test_generation} != "${test_root}"/* ||
            ${test_journal} != "${test_root}"/* ||
            ${test_helper} != "${test_root}"/* ]]; then
            gentoo_opt_error 'profile transaction test overrides are forbidden or incomplete'
            return 1
        fi
        if [[ -e ${production_journal} || -L ${production_journal} ||
            -e ${production_journal}.child.json ||
            -L ${production_journal}.child.json ]]; then
            gentoo_opt_error 'a test transaction cannot override production transaction state'
            return 1
        fi
        journal=${test_journal}
        helper=${test_helper}
        test_mode=1
        helper_arguments+=(
            --test-mode
            --test-root "${test_root}"
            --test-framework-lock "${test_framework}"
            --test-project-lock "${test_project}"
            --test-generation-lock "${test_generation}"
            --test-journal "${test_journal}"
        )
    fi

    if [[ ! -e ${journal} && ! -L ${journal} ]]; then
        if [[ -e ${journal}.partial || -L ${journal}.partial ||
            -e ${journal}.child.json || -L ${journal}.child.json ||
            -e ${journal}.child.json.partial || -L ${journal}.child.json.partial ||
            -n ${token}${authorization} || ${test_mode} == 1 ]]; then
            gentoo_opt_error 'stale or partial production profile transaction state lacks its journal'
            return 1
        fi
        return 0
    fi
    [[ ${token} =~ ^[0-9a-f]{64}$ && -n ${authorization} ]] || {
        gentoo_opt_error 'active profile-lock transaction lacks its coordinator authorization'
        return 1
    }
    if ((test_mode)); then
        [[ ${authorization} == "${test_root}"/* && -f ${helper} &&
            ! -L ${helper} && -x ${helper} ]] || {
            gentoo_opt_error 'test transaction authorization or verifier escapes its private root'
            return 1
        }
    else
        [[ -x ${helper} && -f ${helper} && ! -L ${helper} ]] || {
            gentoo_opt_error 'candidate-bound production transaction verifier is unavailable'
            return 1
        }
    fi
    helper_arguments+=(--token-fd 0 --authorization "${authorization}")
    if ! printf '%s\n' "${token}" | "${helper}" "${helper_arguments[@]}" >/dev/null; then
        gentoo_opt_error 'coordinator rejected the active production profile transaction'
        return 1
    fi
}

gentoo_opt_validate_profile_transaction_guard || {
    gentoo_opt_abort 'a production profile-lock transaction is incomplete or unauthorized' || {
        if [[ ${BASH_SOURCE[0]} == "$0" ]]; then exit 1; fi
        return 1
    }
}
unset -f gentoo_opt_validate_profile_transaction_guard
unset gentoo_opt_profile_transaction_token \
    gentoo_opt_profile_transaction_authorization \
    gentoo_opt_profile_transaction_test_root \
    gentoo_opt_profile_transaction_test_framework_lock \
    gentoo_opt_profile_transaction_test_project_lock \
    gentoo_opt_profile_transaction_test_generation_lock \
    gentoo_opt_profile_transaction_test_journal \
    gentoo_opt_profile_transaction_test_helper

gentoo_opt_append_flag_once() {
    local variable=$1 flag=$2 value
    value=${!variable-}
    case " ${value} " in
        *" ${flag} "*) return 0 ;;
    esac
    if [[ -n ${value} ]]; then
        printf -v "${variable}" '%s %s' "${value}" "${flag}"
    else
        printf -v "${variable}" '%s' "${flag}"
    fi
    # shellcheck disable=SC2163  # The indirect variable name is intentional.
    export "${variable?}"
}

gentoo_opt_require_exact_build_id_policy() {
    local variable=$1 expected=$2 value word count=0
    local -a words=()
    value=${!variable-}
    read -r -a words <<< "${value}"
    for word in "${words[@]}"; do
        [[ ${word} == *--build-id* ]] || continue
        [[ ${word} == "${expected}" ]] || {
            gentoo_opt_error "${variable} contains a conflicting build-ID policy: ${word}"
            return 1
        }
        count=$((count + 1))
    done
    ((count <= 1)) || {
        gentoo_opt_error "${variable} contains the exact build-ID policy more than once"
        return 1
    }
}

gentoo_opt_require_no_build_id_policy() {
    local variable=$1 value word
    local -a words=()
    value=${!variable-}
    read -r -a words <<< "${value}"
    for word in "${words[@]}"; do
        [[ ${word} != *--build-id* ]] || {
            gentoo_opt_error "${variable} must not carry the stage build-ID policy: ${word}"
            return 1
        }
    done
}

gentoo_opt_append_colon_path_once() {
    local variable=$1 path=$2 value
    gentoo_opt_safe_absolute_path "${path}" || {
        gentoo_opt_error "${variable} entry must be a safe absolute path"
        return 1
    }
    value=${!variable-}
    case ":${value}:" in
        *":${path}:"*) return 0 ;;
    esac
    if [[ -n ${value} ]]; then
        printf -v "${variable}" '%s:%s' "${value}" "${path}"
    else
        printf -v "${variable}" '%s' "${path}"
    fi
    # shellcheck disable=SC2163  # The indirect variable name is intentional.
    export "${variable?}"
}

gentoo_opt_allow_sandbox_write() {
    local path=$1
    gentoo_opt_append_colon_path_once SANDBOX_WRITE "${path}" || return 1
    if declare -F addwrite >/dev/null; then
        addwrite "${path}" || return 1
    fi
}

gentoo_opt_fixture_override_allowed() {
    if [[ ${GENTOO_OPT_DISPATCHER_TEST_MODE:-0} == 1 && -z ${EBUILD_PHASE-} ]]; then
        return 0
    fi
    [[ ${GENTOO_OPT_PORTAGE_FIXTURE_MODE:-0} == 1 &&
        ${CATEGORY-} == app-test ]] || return 1
    case ${PN-}:${EBUILD-} in
        phase2-portage-fixture:/var/tmp/gentoo-phase2-portage-fixture.*/app-test/phase2-portage-fixture/phase2-portage-fixture-1.ebuild | \
        phase2-pgo-use-fixture:/var/tmp/gentoo-phase2-pgo-portage.*/app-test/phase2-pgo-use-fixture/phase2-pgo-use-fixture-1.ebuild)
            return 0
            ;;
        *) return 1 ;;
    esac
}

gentoo_opt_trusted_root_path() {
    local path=$1 kind=$2 canonical current owner mode
    gentoo_opt_safe_absolute_path "${path}" || return 1
    canonical=$(realpath -e -- "${path}") || return 1
    [[ ${canonical} == "${path}" ]] || return 1
    case ${kind} in
        executable) [[ -f ${path} && -x ${path} ]] || return 1 ;;
        file) [[ -f ${path} ]] || return 1 ;;
        directory) [[ -d ${path} ]] || return 1 ;;
        *) return 1 ;;
    esac

    # Checking only the leaf is insufficient: a root-owned executable below a
    # replaceable directory is still controlled by whoever can rename that
    # directory.  Reject symlinks and group/other-writable permissions at every
    # component, including / itself.
    current=${path}
    while :; do
        [[ ! -L ${current} ]] || return 1
        owner=$(stat -c %u -- "${current}") || return 1
        mode=$(stat -c %a -- "${current}") || return 1
        [[ ${owner} == 0 && ${mode} =~ ^[0-7]{3,4}$ ]] || return 1
        (( (8#${mode} & 8#022) == 0 )) || return 1
        [[ ${current} == / ]] && break
        current=${current%/*}
        [[ -n ${current} ]] || current=/
    done
}

gentoo_opt_trusted_root_executable() {
    gentoo_opt_trusted_root_path "$1" executable
}

gentoo_opt_path_is_below() {
    local path=$1 root=$2
    [[ ${path} == "${root}/"* ]]
}

gentoo_opt_require_immutable_input() {
    local path=$1 root=$2 kind=$3 label=$4
    gentoo_opt_safe_absolute_path "${path}" || {
        gentoo_opt_error "${label} must be a safe absolute path"
        return 1
    }
    if gentoo_opt_fixture_override_allowed; then
        case ${kind} in
            file) [[ -f ${path} && ! -L ${path} ]] ;;
            directory) [[ -d ${path} && ! -L ${path} ]] ;;
            *) return 1 ;;
        esac || {
            gentoo_opt_error "${label} is unavailable or symlinked: ${path}"
            return 1
        }
        return 0
    fi
    gentoo_opt_path_is_below "${path}" "${root}" || {
        gentoo_opt_error "${label} is outside reviewed root-owned namespace ${root}"
        return 1
    }
    gentoo_opt_trusted_root_path "${path}" "${kind}" || {
        gentoo_opt_error "${label} or one of its ancestors is not immutable root-owned state: ${path}"
        return 1
    }
}

gentoo_opt_require_immutable_tree() {
    local root=$1 entry
    if gentoo_opt_fixture_override_allowed; then
        [[ -d ${root} && ! -L ${root} ]]
        return
    fi
    while IFS= read -r -d '' entry; do
        if [[ -d ${entry} && ! -L ${entry} ]]; then
            gentoo_opt_trusted_root_path "${entry}" directory || return 1
        elif [[ -f ${entry} && ! -L ${entry} ]]; then
            gentoo_opt_trusted_root_path "${entry}" file || return 1
        else
            return 1
        fi
    done < <(find "${root}" -xdev -print0)
}

gentoo_opt_require_generation_spool() {
    local path=$1 current owner mode
    gentoo_opt_safe_absolute_path "${path}" || {
        gentoo_opt_error 'generation profile path must be a safe absolute path'
        return 1
    }
    if gentoo_opt_fixture_override_allowed; then
        [[ -d ${path} && -w ${path} && ! -L ${path} ]] || {
            gentoo_opt_error "fixture generation spool is unavailable: ${path}"
            return 1
        }
        return 0
    fi
    gentoo_opt_path_is_below "${path}" /var/tmp/gentoo-optimization/pgo-raw || {
        gentoo_opt_error 'generation profiles must use /var/tmp/gentoo-optimization/pgo-raw/<generation-specific-path>'
        return 1
    }
    current=${path}
    while :; do
        [[ -d ${current} && ! -L ${current} ]] || return 1
        owner=$(stat -c %u -- "${current}") || return 1
        mode=$(stat -c %a -- "${current}") || return 1
        [[ ${owner} == 0 && ${mode} =~ ^[0-7]{3,4}$ ]] || return 1
        if [[ ${current} == "${path}" ]]; then
            # The exact leaf may deliberately be 01777 for runtime writers,
            # but any broadly writable leaf must retain sticky semantics.
            if (( (8#${mode} & 8#022) != 0 )); then
                (( (8#${mode} & 8#1000) != 0 )) || return 1
            fi
        elif [[ ${current} == /var/tmp ]]; then
            (( (8#${mode} & 8#1000) != 0 )) || return 1
        else
            (( (8#${mode} & 8#022) == 0 )) || return 1
        fi
        [[ ${current} == / ]] && break
        current=${current%/*}
        [[ -n ${current} ]] || current=/
    done
    [[ -w ${path} ]] || {
        gentoo_opt_error "generation profile spool is not writable: ${path}"
        return 1
    }
}

gentoo_opt_require_bolt_cache_root() {
    local path=${1-}
    if gentoo_opt_fixture_override_allowed; then
        gentoo_opt_safe_absolute_path "${path}" || {
            gentoo_opt_error 'fixture BOLT stage requires a safe absolute cache root'
            return 1
        }
        return 0
    fi
    [[ ${path} == /var/cache/gentoo-optimization/bolt ]] || {
        gentoo_opt_error 'production BOLT cache root must be exactly /var/cache/gentoo-optimization/bolt'
        return 1
    }
    gentoo_opt_trusted_root_path "${path}" directory || {
        gentoo_opt_error 'production BOLT cache root or an ancestor is not trusted root-owned state'
        return 1
    }
}

gentoo_opt_disable_ccache() {
    gentoo_opt_append_flag_once FEATURES -ccache
    gentoo_opt_append_flag_once FEATURES -distcc
    gentoo_opt_append_flag_once FEATURES -icecream
    CCACHE_DISABLE=1
    SCCACHE_DISABLE=1
    RUSTC_WRAPPER=
    export CCACHE_DISABLE SCCACHE_DISABLE RUSTC_WRAPPER
}

gentoo_opt_normalize_abi() {
    case ${1-} in
        amd64|64|x86_64) printf '%s\n' amd64 ;;
        x86|32|i386|i486|i586|i686) printf '%s\n' x86 ;;
        *) return 1 ;;
    esac
}

gentoo_opt_detect_abi() {
    local detected requested
    if [[ -n ${ABI-} ]]; then
        detected=$(gentoo_opt_normalize_abi "${ABI}") || {
            gentoo_opt_error "unsupported Portage ABI: ${ABI}"
            return 1
        }
    else
        case ${CHOST-} in
            x86_64-*) detected=amd64 ;;
            i?86-*) detected=x86 ;;
            *)
                gentoo_opt_error 'ABI is unset and CHOST cannot identify an x86 ABI'
                return 1
                ;;
        esac
    fi
    requested=$(gentoo_opt_normalize_abi "${GENTOO_OPT_ABI-}") || {
        gentoo_opt_error 'active mode requires GENTOO_OPT_ABI=amd64 or x86'
        return 1
    }
    if [[ ${detected} != "${requested}" ]]; then
        gentoo_opt_error "ABI mismatch: Portage=${detected}, requested=${requested}"
        return 1
    fi
    GENTOO_OPT_ACTIVE_ABI=${detected}
}

gentoo_opt_load_fingerprint() {
    local loaded='' line='' computed='' line_count
    if [[ -n ${GENTOO_OPT_FINGERPRINT_FILE-} ]]; then
        gentoo_opt_require_immutable_input "${GENTOO_OPT_FINGERPRINT_FILE}" \
            /var/lib/gentoo-optimization/generations file 'fingerprint file' || return 1
        IFS= read -r line < "${GENTOO_OPT_FINGERPRINT_FILE}" || {
            gentoo_opt_error "cannot read fingerprint file: ${GENTOO_OPT_FINGERPRINT_FILE}"
            return 1
        }
        line_count=$(wc -l < "${GENTOO_OPT_FINGERPRINT_FILE}") || return 1
        [[ ${line_count} == 1 && ${line} =~ ^fingerprint=([0-9a-f]{64})$ ]] || {
            gentoo_opt_error 'fingerprint file must contain exactly fingerprint=<64 lowercase hex>'
            return 1
        }
        loaded=${BASH_REMATCH[1]}
    fi

    if [[ -n ${GENTOO_OPT_IDENTITY_INPUT-} ]]; then
        gentoo_opt_require_immutable_input "${GENTOO_OPT_IDENTITY_INPUT}" \
            /var/lib/gentoo-optimization/generations file 'fingerprint identity input' || return 1
        gentoo_opt_profile_key_tool || return 1
        computed=$("${GENTOO_OPT_SELECTED_PROFILE_KEY_TOOL}" fingerprint \
            --input "${GENTOO_OPT_IDENTITY_INPUT}") || {
            gentoo_opt_error 'fingerprint computation failed'
            return 1
        }
        [[ ${computed} =~ ^[0-9a-f]{64}$ ]] || {
            gentoo_opt_error 'fingerprint tool did not emit exactly 64 lowercase hex characters'
            return 1
        }
        if [[ -n ${loaded} && ${loaded} != "${computed}" ]]; then
            gentoo_opt_error 'loaded and computed fingerprints differ'
            return 1
        fi
        loaded=${computed}
    fi

    if [[ -n ${GENTOO_OPT_FINGERPRINT-} ]]; then
        gentoo_opt_fixture_override_allowed || {
            gentoo_opt_error 'production builds must load or compute fingerprints from reviewed root-owned generation state'
            return 1
        }
        [[ ${GENTOO_OPT_FINGERPRINT} =~ ^[0-9a-f]{64}$ ]] || {
            gentoo_opt_error 'GENTOO_OPT_FINGERPRINT must be 64 lowercase hex characters'
            return 1
        }
        if [[ -n ${loaded} && ${loaded} != "${GENTOO_OPT_FINGERPRINT}" ]]; then
            gentoo_opt_error 'explicit and loaded/computed fingerprints differ'
            return 1
        fi
        loaded=${GENTOO_OPT_FINGERPRINT}
    fi
    [[ -n ${loaded} ]] || {
        gentoo_opt_error 'active mode requires an exact package fingerprint'
        return 1
    }
    GENTOO_OPT_ACTIVE_FINGERPRINT=${loaded}
}

gentoo_opt_profile_key_tool() {
    local expected configured
    expected=/usr/local/libexec/gentoo-optimization/pgo/profile-identity.py
    configured=${GENTOO_OPT_PROFILE_KEY_TOOL:-${expected}}
    gentoo_opt_safe_absolute_path "${configured}" || {
        gentoo_opt_error 'GENTOO_OPT_PROFILE_KEY_TOOL must be a safe absolute path'
        return 1
    }
    if [[ ${configured} != "${expected}" ]]; then
        gentoo_opt_fixture_override_allowed || {
            gentoo_opt_error 'production fingerprint computation cannot override the installed profile identity tool'
            return 1
        }
    elif ! gentoo_opt_trusted_root_executable "${configured}"; then
        gentoo_opt_error "installed profile identity tool is not trusted through every ancestor: ${configured}"
        return 1
    fi
    [[ -f ${configured} && -x ${configured} && ! -L ${configured} ]] || {
        gentoo_opt_error "profile identity tool is unavailable or symlinked: ${configured}"
        return 1
    }
    GENTOO_OPT_SELECTED_PROFILE_KEY_TOOL=${configured}
}

gentoo_opt_resolve_tool() {
    local variable=$1 fallback=$2 value path
    value=${!variable:-${fallback}}
    [[ ${value} != *[$'\n\r\t ']* && ${value} != *[\;\&\|\<\>\`]* ]] || {
        gentoo_opt_error "${variable} must name one command without shell syntax"
        return 1
    }
    path=$(command -v -- "${value}") || {
        gentoo_opt_error "cannot resolve ${variable} command: ${value}"
        return 1
    }
    path=$(realpath -e -- "${path}") || {
        gentoo_opt_error "cannot canonicalize ${variable} command: ${path}"
        return 1
    }
    GENTOO_OPT_RESOLVED_TOOL=${path}
}

# Portage implements FEATURES=ccache by prepending a masquerade directory to
# PATH.  Resolving one of those symlinks with realpath yields /usr/bin/ccache,
# which is the wrapper rather than the compiler whose identity must enter the
# package fingerprint.  Active lanes disable caching and deliberately resolve
# past all recognized compiler-cache/distribution wrappers.  An explicit path
# to a wrapper is rejected instead of guessed through.
gentoo_opt_is_compiler_wrapper() {
    local path=$1 canonical basename
    canonical=$(realpath -e -- "${path}") || return 1
    basename=${canonical##*/}
    case ${basename} in
        ccache|sccache|distcc|icecc) return 0 ;;
        *) return 1 ;;
    esac
}

gentoo_opt_resolve_compiler_tool() {
    local variable=$1 fallback=$2 value directory candidate canonical
    value=${!variable:-${fallback}}
    [[ ${value} != *[$'\n\r\t ']* && ${value} != *[\;\&\|\<\>\`]* ]] || {
        gentoo_opt_error "${variable} must name one compiler command without shell syntax"
        return 1
    }
    if [[ ${value} == */* ]]; then
        [[ -x ${value} ]] || {
            gentoo_opt_error "cannot execute ${variable} compiler: ${value}"
            return 1
        }
        if gentoo_opt_is_compiler_wrapper "${value}"; then
            gentoo_opt_error "explicit ${variable} resolves to a compiler wrapper: ${value}"
            return 1
        fi
        canonical=$(realpath -e -- "${value}") || return 1
        GENTOO_OPT_RESOLVED_TOOL=${canonical}
        return 0
    fi

    while IFS= read -r -d '' directory; do
        gentoo_opt_safe_absolute_path "${directory}" || continue
        candidate=${directory}/${value}
        [[ -f ${candidate} && -x ${candidate} ]] || continue
        if gentoo_opt_is_compiler_wrapper "${candidate}"; then
            continue
        fi
        canonical=$(realpath -e -- "${candidate}") || continue
        GENTOO_OPT_RESOLVED_TOOL=${canonical}
        return 0
    done < <(printf '%s' "${PATH-}" | tr ':' '\0')
    gentoo_opt_error "cannot resolve unwrapped ${variable} compiler: ${value}"
    return 1
}

gentoo_opt_detect_compiler_family() {
    local requested=${1} variable fallback version cc_path
    case ${requested} in
        clang|gcc) variable=CC; fallback=cc ;;
        rust) variable=RUSTC; fallback=rustc ;;
        go) variable=GO; fallback=go ;;
        *) gentoo_opt_error "unsupported compiler family request: ${requested}"; return 1 ;;
    esac
    gentoo_opt_resolve_compiler_tool "${variable}" "${fallback}" || return 1
    if [[ ${requested} == go ]]; then
        version=$("${GENTOO_OPT_RESOLVED_TOOL}" version 2>&1)
    else
        version=$("${GENTOO_OPT_RESOLVED_TOOL}" --version 2>&1)
    fi || {
        gentoo_opt_error "cannot query compiler identity: ${GENTOO_OPT_RESOLVED_TOOL}"
        return 1
    }
    case ${requested} in
        clang) [[ ${version} == *clang* && ${version} != *rustc* ]] ;;
        gcc) [[ ${version} != *clang* && ${version} == *gcc* ]] ;;
        rust) [[ ${version} == rustc* ]] ;;
        go) [[ ${version} == 'go version '* ]] ;;
    esac || {
        gentoo_opt_error "compiler-family mismatch: requested=${requested}, tool=${GENTOO_OPT_RESOLVED_TOOL}"
        return 1
    }
    if [[ -n ${GENTOO_OPT_COMPILER_FAMILY-} &&
        ${GENTOO_OPT_COMPILER_FAMILY} != "${requested}" ]]; then
        gentoo_opt_error "declared compiler family ${GENTOO_OPT_COMPILER_FAMILY} does not match ${requested} mode"
        return 1
    fi
    GENTOO_OPT_ACTIVE_COMPILER_FAMILY=${requested}
    GENTOO_OPT_ACTIVE_COMPILER=${GENTOO_OPT_RESOLVED_TOOL}
    if ! gentoo_opt_fixture_override_allowed && \
        ! gentoo_opt_trusted_root_executable "${GENTOO_OPT_ACTIVE_COMPILER}"; then
        gentoo_opt_error "active compiler is not immutable through every root-owned ancestor: ${GENTOO_OPT_ACTIVE_COMPILER}"
        return 1
    fi

    if [[ ${requested} == clang || ${requested} == gcc ]]; then
        cc_path=${GENTOO_OPT_ACTIVE_COMPILER}
        gentoo_opt_resolve_compiler_tool CXX c++ || return 1
        version=$("${GENTOO_OPT_RESOLVED_TOOL}" --version 2>&1) || {
            gentoo_opt_error "cannot query C++ compiler identity: ${GENTOO_OPT_RESOLVED_TOOL}"
            return 1
        }
        case ${requested} in
            clang) [[ ${version} == *clang* && ${version} != *rustc* ]] ;;
            gcc) [[ ${version} != *clang* && ( ${version} == *gcc* || ${version} == *'g++'* ) ]] ;;
        esac || {
            gentoo_opt_error "C/C++ compiler-family mismatch: requested=${requested}, CC=${cc_path}, CXX=${GENTOO_OPT_RESOLVED_TOOL}"
            return 1
        }
        GENTOO_OPT_ACTIVE_CXX=${GENTOO_OPT_RESOLVED_TOOL}
        if ! gentoo_opt_fixture_override_allowed && \
            ! gentoo_opt_trusted_root_executable "${GENTOO_OPT_ACTIVE_CXX}"; then
            gentoo_opt_error "active C++ compiler is not immutable through every root-owned ancestor: ${GENTOO_OPT_ACTIVE_CXX}"
            return 1
        fi
        CC=${GENTOO_OPT_ACTIVE_COMPILER}
        CXX=${GENTOO_OPT_ACTIVE_CXX}
        export CC CXX GENTOO_OPT_ACTIVE_CXX
    elif [[ ${requested} == rust ]]; then
        RUSTC=${GENTOO_OPT_ACTIVE_COMPILER}
        export RUSTC
    elif [[ ${requested} == go ]]; then
        GO=${GENTOO_OPT_ACTIVE_COMPILER}
        export GO
    fi
}

gentoo_opt_profile_backend_for_mode() {
    case ${1} in
        clang-ir-generate|clang-ir-use) printf '%s\n' clang-ir ;;
        clang-sample-use) printf '%s\n' clang-sample ;;
        gcc-generate|gcc-use) printf '%s\n' gcc ;;
        rust-generate|rust-use) printf '%s\n' rust ;;
        go-use) printf '%s\n' go ;;
        *) return 1 ;;
    esac
}

gentoo_opt_profile_family_for_mode() {
    case ${1} in
        clang-*) printf '%s\n' clang ;;
        gcc-*) printf '%s\n' gcc ;;
        rust-*) printf '%s\n' rust ;;
        go-*) printf '%s\n' go ;;
        *) return 1 ;;
    esac
}

gentoo_opt_profile_is_use_mode() {
    [[ ${1} == clang-ir-use || ${1} == clang-sample-use || ${1} == gcc-use ||
        ${1} == rust-use || ${1} == go-use ]]
}

gentoo_opt_profile_is_generate_mode() {
    [[ ${1} == clang-ir-generate || ${1} == gcc-generate || ${1} == rust-generate ]]
}

gentoo_opt_hash_profile_directory() {
    local directory=$1 digest
    digest=$(
        set -o pipefail
        cd -- "${directory}" || exit 1
        find . -type f -name '*.gcda' -print0 |
            LC_ALL=C sort -z |
            while IFS= read -r -d '' file; do
                printf '%s\0' "${file}"
                sha256sum -- "${file}" | awk '{print $1}'
            done |
            sha256sum | awk '{print $1}'
    ) || return 1
    printf '%s\n' "${digest}"
}

gentoo_opt_read_profile_manifest() {
    local path=$1 line key value
    local schema='' backend='' fingerprint='' abi='' compiler_family=''
    local profile_path='' profile_sha256='' validation_status=''
    declare -A seen=()
    gentoo_opt_require_immutable_input "${path}" \
        /var/cache/gentoo-optimization/pgo file 'profile manifest' || return 1
    while IFS= read -r line || [[ -n ${line} ]]; do
        [[ ${line} =~ ^([a-z_][a-z0-9_]*)=(.*)$ ]] || {
            gentoo_opt_error "malformed profile manifest line: ${line}"
            return 1
        }
        key=${BASH_REMATCH[1]}; value=${BASH_REMATCH[2]}
        [[ -z ${seen[${key}]+x} ]] || {
            gentoo_opt_error "duplicate profile manifest key: ${key}"
            return 1
        }
        seen[${key}]=1
        case ${key} in
            schema) schema=${value} ;;
            backend) backend=${value} ;;
            fingerprint) fingerprint=${value} ;;
            abi) abi=${value} ;;
            compiler_family) compiler_family=${value} ;;
            profile_path) profile_path=${value} ;;
            profile_sha256) profile_sha256=${value} ;;
            validation_status) validation_status=${value} ;;
            *) gentoo_opt_error "unknown profile manifest key: ${key}"; return 1 ;;
        esac
    done < "${path}"
    [[ ${schema} == gentoo-optimization-profile-v1 ]] || {
        gentoo_opt_error 'unsupported profile manifest schema'; return 1;
    }
    [[ ${backend} == "${GENTOO_OPT_ACTIVE_BACKEND}" ]] || {
        gentoo_opt_error "profile backend mismatch: manifest=${backend}, requested=${GENTOO_OPT_ACTIVE_BACKEND}"; return 1;
    }
    [[ ${fingerprint} == "${GENTOO_OPT_ACTIVE_FINGERPRINT}" ]] || {
        gentoo_opt_error 'profile fingerprint mismatch'; return 1;
    }
    [[ ${abi} == "${GENTOO_OPT_ACTIVE_ABI}" ]] || {
        gentoo_opt_error "profile ABI mismatch: manifest=${abi}, requested=${GENTOO_OPT_ACTIVE_ABI}"; return 1;
    }
    [[ ${compiler_family} == "${GENTOO_OPT_ACTIVE_COMPILER_FAMILY}" ]] || {
        gentoo_opt_error 'profile compiler-family mismatch'; return 1;
    }
    [[ ${validation_status} == passed ]] || {
        gentoo_opt_error 'profile manifest does not carry validation_status=passed'; return 1;
    }
    gentoo_opt_safe_absolute_path "${profile_path}" || {
        gentoo_opt_error 'manifest profile_path is not a safe absolute path'; return 1;
    }
    [[ ${profile_path} == "${GENTOO_OPT_PROFILE_PATH}" ]] || {
        gentoo_opt_error 'manifest and requested profile paths differ'; return 1;
    }
    [[ ${profile_sha256} =~ ^[0-9a-f]{64}$ ]] || {
        gentoo_opt_error 'profile manifest has an invalid SHA-256'; return 1;
    }
    GENTOO_OPT_MANIFEST_PROFILE_SHA256=${profile_sha256}
}

gentoo_opt_validate_profile_format() {
    local expected_validator validator metadata compiler_identity
    local metadata_compiler metadata_compiler_sha256 active_compiler_sha256
    expected_validator=/usr/local/libexec/gentoo-optimization/pgo/validate-profile.py
    validator=${GENTOO_OPT_PROFILE_VALIDATOR:-${expected_validator}}
    if [[ ${validator} != "${expected_validator}" ]]; then
        gentoo_opt_fixture_override_allowed || {
            gentoo_opt_error 'production profile use cannot override the authoritative validator'; return 1;
        }
    fi
    gentoo_opt_safe_absolute_path "${validator}" || {
        gentoo_opt_error 'profile validator must be a safe absolute path'; return 1;
    }
    [[ -f ${validator} && -x ${validator} && ! -L ${validator} ]] || {
        gentoo_opt_error "profile validator is unavailable, non-regular, or symlinked: ${validator}"; return 1;
    }
    if [[ ${validator} == "${expected_validator}" ]] && \
        ! gentoo_opt_trusted_root_executable "${validator}"; then
        gentoo_opt_error "authoritative profile validator is not a trusted root executable: ${validator}"
        return 1
    fi
    gentoo_opt_safe_absolute_path "${GENTOO_OPT_PROFILE_METADATA-}" || {
        gentoo_opt_error 'profile use requires a safe absolute GENTOO_OPT_PROFILE_METADATA'; return 1;
    }
    metadata=${GENTOO_OPT_PROFILE_METADATA}
    [[ ${metadata} == "${GENTOO_OPT_PROFILE_MANIFEST}.metadata.json" ]] || {
        gentoo_opt_error 'profile metadata must be the deterministic <manifest>.metadata.json sidecar'; return 1;
    }
    gentoo_opt_require_immutable_input "${metadata}" \
        /var/cache/gentoo-optimization/pgo file 'profile validation metadata' || return 1
    [[ -s ${metadata} ]] || {
        gentoo_opt_error "profile metadata is empty: ${metadata}"; return 1;
    }
    "${validator}" verify --manifest "${GENTOO_OPT_PROFILE_MANIFEST}" \
        --metadata "${metadata}" || {
        gentoo_opt_error 'authoritative profile manifest/sidecar verification failed'; return 1;
    }

    # The authoritative sidecar contains the complete compiler observation
    # used when the profile was published.  Family equality is not enough:
    # bind profile consumption to the exact compiler realpath and bytes that
    # were resolved for this build.
    # Hermetic dispatcher and bounded Portage fixtures may run in a user
    # namespace where host-root files are deliberately mapped to an overflow
    # UID.  They still execute the exact /usr/bin/jq below, but cannot prove
    # its host ownership from that namespace.  Production never qualifies for
    # this fixture-only exemption and must retain the complete ancestor check.
    if ! gentoo_opt_fixture_override_allowed && \
        ! gentoo_opt_trusted_root_executable /usr/bin/jq; then
        gentoo_opt_error 'cannot trust the exact /usr/bin/jq metadata reader'
        return 1
    fi
    compiler_identity=$(/usr/bin/jq -er \
        'if (.compiler | type) == "object" and (.compiler.path | type) == "string" and (.compiler.sha256 | type) == "string" then .compiler.path, .compiler.sha256 else error("missing compiler identity") end' \
        -- "${metadata}") || {
        gentoo_opt_error 'cannot extract the exact compiler identity from validation metadata'
        return 1
    }
    [[ ${compiler_identity} == *$'\n'* && ${compiler_identity} != *$'\n'*$'\n'* ]] || {
        gentoo_opt_error 'validation metadata compiler identity is not exactly path plus SHA-256'
        return 1
    }
    metadata_compiler=${compiler_identity%%$'\n'*}
    metadata_compiler_sha256=${compiler_identity#*$'\n'}
    gentoo_opt_safe_absolute_path "${metadata_compiler}" || {
        gentoo_opt_error 'validation metadata compiler path is unsafe'
        return 1
    }
    [[ ${metadata_compiler_sha256} =~ ^[0-9a-f]{64}$ ]] || {
        gentoo_opt_error 'validation metadata compiler SHA-256 is malformed'
        return 1
    }
    [[ ${metadata_compiler} == "${GENTOO_OPT_ACTIVE_COMPILER}" ]] || {
        gentoo_opt_error 'profile compiler path differs from the compiler resolved for this build'
        return 1
    }
    active_compiler_sha256=$(sha256sum -- "${GENTOO_OPT_ACTIVE_COMPILER}") || return 1
    active_compiler_sha256=${active_compiler_sha256%% *}
    [[ ${metadata_compiler_sha256} == "${active_compiler_sha256}" ]] || {
        gentoo_opt_error 'profile compiler hash differs from the compiler resolved for this build'
        return 1
    }
}

gentoo_opt_prepare_profile_path() {
    local mode=$1 actual_hash='' gcda_count
    gentoo_opt_safe_absolute_path "${GENTOO_OPT_PROFILE_PATH-}" || {
        gentoo_opt_error 'active PGO mode requires a safe absolute GENTOO_OPT_PROFILE_PATH'; return 1;
    }
    if gentoo_opt_profile_is_generate_mode "${mode}"; then
        gentoo_opt_require_generation_spool "${GENTOO_OPT_PROFILE_PATH}" || return 1
        gentoo_opt_allow_sandbox_write "${GENTOO_OPT_PROFILE_PATH}" || return 1
        return 0
    fi
    [[ -n ${GENTOO_OPT_PROFILE_MANIFEST-} ]] || {
        gentoo_opt_error 'profile-use mode requires GENTOO_OPT_PROFILE_MANIFEST'; return 1;
    }
    if [[ ${GENTOO_OPT_ACTIVE_BACKEND} == gcc ]]; then
        gentoo_opt_require_immutable_input "${GENTOO_OPT_PROFILE_PATH}" \
            /var/cache/gentoo-optimization/pgo directory 'GCC profile directory' || return 1
        gentoo_opt_require_immutable_tree "${GENTOO_OPT_PROFILE_PATH}" || {
            gentoo_opt_error 'GCC profile tree contains mutable, symlinked, or non-root-owned input'
            return 1
        }
        gcda_count=$(find "${GENTOO_OPT_PROFILE_PATH}" -type f -name '*.gcda' -size +0c -print -quit)
        [[ -n ${gcda_count} ]] || {
            gentoo_opt_error 'GCC profile directory contains no nonempty .gcda file'; return 1;
        }
    else
        gentoo_opt_require_immutable_input "${GENTOO_OPT_PROFILE_PATH}" \
            /var/cache/gentoo-optimization/pgo file 'profile payload' || return 1
        [[ -s ${GENTOO_OPT_PROFILE_PATH} ]] || {
            gentoo_opt_error "profile file is empty: ${GENTOO_OPT_PROFILE_PATH}"; return 1;
        }
    fi
    gentoo_opt_read_profile_manifest "${GENTOO_OPT_PROFILE_MANIFEST}" || return 1
    if [[ ${GENTOO_OPT_ACTIVE_BACKEND} == gcc ]]; then
        actual_hash=$(gentoo_opt_hash_profile_directory "${GENTOO_OPT_PROFILE_PATH}") || {
            gentoo_opt_error 'cannot hash GCC profile directory'; return 1;
        }
    else
        actual_hash=$(sha256sum -- "${GENTOO_OPT_PROFILE_PATH}") || return 1
        actual_hash=${actual_hash%% *}
    fi
    [[ ${actual_hash} == "${GENTOO_OPT_MANIFEST_PROFILE_SHA256}" ]] || {
        gentoo_opt_error 'profile payload SHA-256 mismatch'; return 1;
    }
    gentoo_opt_validate_profile_format "${GENTOO_OPT_ACTIVE_BACKEND}" \
        "${GENTOO_OPT_PROFILE_PATH}" || return 1
}

gentoo_opt_require_rust_target_isolation() {
    [[ -n ${GENTOO_OPT_RUST_TARGET-} &&
        ${GENTOO_OPT_RUST_TARGET} =~ ^[A-Za-z0-9_.-]+$ ]] || {
        gentoo_opt_error 'Rust PGO requires an explicit GENTOO_OPT_RUST_TARGET'; return 1;
    }
    if [[ -n ${CARGO_BUILD_TARGET-} &&
        ${CARGO_BUILD_TARGET} != "${GENTOO_OPT_RUST_TARGET}" ]]; then
        gentoo_opt_error 'CARGO_BUILD_TARGET and GENTOO_OPT_RUST_TARGET differ'; return 1
    fi
    CARGO_BUILD_TARGET=${GENTOO_OPT_RUST_TARGET}
    export CARGO_BUILD_TARGET
}

gentoo_opt_require_go_single_main() {
    [[ ${GENTOO_OPT_GO_MAIN_COUNT-} == 1 ]] || {
        gentoo_opt_error 'generic Go PGO requires a proven single-main package'
        return 1
    }
    [[ ${GENTOO_OPT_GO_BINARY-} =~ ^[A-Za-z0-9_.+-]+$ ]] || {
        gentoo_opt_error 'generic Go PGO requires one exact GENTOO_OPT_GO_BINARY name'
        return 1
    }
}

gentoo_opt_apply_primary_mode() {
    local mode=$1 flag
    GENTOO_OPT_ACTIVE_BACKEND=$(gentoo_opt_profile_backend_for_mode "${mode}") || return 1
    gentoo_opt_disable_ccache
    gentoo_opt_detect_compiler_family "$(gentoo_opt_profile_family_for_mode "${mode}")" || return 1
    gentoo_opt_prepare_profile_path "${mode}" || return 1
    case ${mode} in
        clang-ir-generate)
            flag="-fprofile-instr-generate=${GENTOO_OPT_PROFILE_PATH}/%m-%p.profraw"
            gentoo_opt_append_flag_once CFLAGS "${flag}"
            gentoo_opt_append_flag_once CXXFLAGS "${flag}"
            gentoo_opt_append_flag_once LDFLAGS "${flag}"
            ;;
        clang-ir-use)
            flag="-fprofile-use=${GENTOO_OPT_PROFILE_PATH}"
            gentoo_opt_append_flag_once CFLAGS "${flag}"
            gentoo_opt_append_flag_once CXXFLAGS "${flag}"
            gentoo_opt_append_flag_once LDFLAGS "${flag}"
            ;;
        clang-sample-use)
            flag="-fprofile-sample-use=${GENTOO_OPT_PROFILE_PATH}"
            gentoo_opt_append_flag_once CFLAGS "${flag}"
            gentoo_opt_append_flag_once CXXFLAGS "${flag}"
            gentoo_opt_append_flag_once CFLAGS -fsample-profile-use-profi
            gentoo_opt_append_flag_once CXXFLAGS -fsample-profile-use-profi
            ;;
        gcc-generate)
            flag="-fprofile-generate=${GENTOO_OPT_PROFILE_PATH}"
            gentoo_opt_append_flag_once CFLAGS "${flag}"
            gentoo_opt_append_flag_once CXXFLAGS "${flag}"
            gentoo_opt_append_flag_once LDFLAGS "${flag}"
            ;;
        gcc-use)
            flag="-fprofile-use=${GENTOO_OPT_PROFILE_PATH}"
            gentoo_opt_append_flag_once CFLAGS "${flag}"
            gentoo_opt_append_flag_once CXXFLAGS "${flag}"
            gentoo_opt_append_flag_once LDFLAGS "${flag}"
            gentoo_opt_append_flag_once CFLAGS -fprofile-correction
            gentoo_opt_append_flag_once CXXFLAGS -fprofile-correction
            gentoo_opt_append_flag_once LDFLAGS -fprofile-correction
            ;;
        rust-generate)
            gentoo_opt_require_rust_target_isolation || return 1
            gentoo_opt_append_flag_once RUSTFLAGS "-Cprofile-generate=${GENTOO_OPT_PROFILE_PATH}"
            ;;
        rust-use)
            gentoo_opt_require_rust_target_isolation || return 1
            gentoo_opt_append_flag_once RUSTFLAGS "-Cprofile-use=${GENTOO_OPT_PROFILE_PATH}"
            ;;
        go-use)
            gentoo_opt_require_go_single_main || return 1
            gentoo_opt_append_flag_once GOFLAGS "-pgo=${GENTOO_OPT_PROFILE_PATH}"
            ;;
    esac
}

gentoo_opt_apply_readiness_flags() {
    local family=${GENTOO_OPT_ACTIVE_COMPILER_FAMILY-} flag
    if [[ ${GENTOO_OPT_BOLT_GCC_READY:-0} == 1 && ${family} != gcc ]]; then
        gentoo_opt_error 'bolt-gcc readiness cannot be applied outside the GCC lane'
        return 1
    fi
    if [[ ${GENTOO_OPT_PROFILE_MAP_READY:-0} == 1 ]]; then
        [[ ${family} == clang ]] || {
            gentoo_opt_error 'profile-map readiness is supported only in the Clang lane'; return 1;
        }
        # sample-convert binds the mapped input to exactly one GNU build ID.
        # Keep that identity stage-owned instead of relying on an ebuild or a
        # global linker default.
        gentoo_opt_require_no_build_id_policy CFLAGS || return 1
        gentoo_opt_require_no_build_id_policy CXXFLAGS || return 1
        gentoo_opt_require_exact_build_id_policy \
            LDFLAGS -Wl,--build-id=sha1 || return 1
        gentoo_opt_append_flag_once LDFLAGS -Wl,--build-id=sha1
        for flag in -gline-tables-only -fdebug-info-for-profiling \
            -funique-internal-linkage-names -fpseudo-probe-for-profiling; do
            gentoo_opt_append_flag_once CFLAGS "${flag}"
            gentoo_opt_append_flag_once CXXFLAGS "${flag}"
        done
    fi
    if [[ ${GENTOO_OPT_ACTIVE_BOLT_STAGE} == capture ||
        ${GENTOO_OPT_ACTIVE_BOLT_STAGE} == deploy ]]; then
        case ${family} in
            clang|gcc)
                gentoo_opt_require_no_build_id_policy CFLAGS || return 1
                gentoo_opt_require_no_build_id_policy CXXFLAGS || return 1
                gentoo_opt_require_exact_build_id_policy \
                    LDFLAGS -Wl,--build-id=sha1 || return 1
                if [[ ${family} == clang ]]; then
                    gentoo_opt_append_flag_once CFLAGS -gline-tables-only
                    gentoo_opt_append_flag_once CXXFLAGS -gline-tables-only
                else
                    gentoo_opt_append_flag_once CFLAGS -g1
                    gentoo_opt_append_flag_once CXXFLAGS -g1
                fi
                gentoo_opt_append_flag_once LDFLAGS -Wl,--emit-relocs
                gentoo_opt_append_flag_once LDFLAGS -Wl,--build-id=sha1
                if [[ ${family} == gcc ]]; then
                    [[ ${GENTOO_OPT_BOLT_GCC_READY:-0} == 1 ]] || {
                        gentoo_opt_error 'GCC BOLT builds require bolt-gcc-ready.conf'; return 1;
                    }
                    gentoo_opt_append_flag_once CFLAGS -fno-reorder-blocks-and-partition
                    gentoo_opt_append_flag_once CXXFLAGS -fno-reorder-blocks-and-partition
                fi
                ;;
            rust)
                # Require a target even in BOLT-only readiness so these flags
                # cannot leak into host build scripts.
                gentoo_opt_require_rust_target_isolation || return 1
                gentoo_opt_require_exact_build_id_policy \
                    RUSTFLAGS -Clink-arg=-Wl,--build-id=sha1 || return 1
                gentoo_opt_append_flag_once RUSTFLAGS -Cdebuginfo=1
                gentoo_opt_append_flag_once RUSTFLAGS -Clink-arg=-Wl,--emit-relocs
                gentoo_opt_append_flag_once RUSTFLAGS -Clink-arg=-Wl,--build-id=sha1
                ;;
            go)
                # Go's native/external linker and build-ID policies differ by
                # package.  Capture the exact package-produced input without
                # leaking C/C++ flags; the artifact classifier remains the
                # fail-closed BOLT eligibility gate.
                ;;
            *) gentoo_opt_error 'BOLT readiness has no supported compiler lane'; return 1 ;;
        esac
    elif [[ ${GENTOO_OPT_BOLT_GCC_READY:-0} == 1 ]]; then
        gentoo_opt_error 'bolt-gcc readiness requires an active BOLT capture/deploy stage'
        return 1
    fi
}

gentoo_opt_log_selection() {
    local profile=${GENTOO_OPT_PROFILE_PATH:--}
    local message="mode=${GENTOO_OPT_MODE} active_mode=${GENTOO_OPT_ACTIVE_MODE} bolt_stage=${GENTOO_OPT_ACTIVE_BOLT_STAGE} backend=${GENTOO_OPT_ACTIVE_BACKEND:-none} abi=${GENTOO_OPT_ACTIVE_ABI} compiler=${GENTOO_OPT_ACTIVE_COMPILER_FAMILY:-none} cc=${GENTOO_OPT_ACTIVE_COMPILER:-none} cxx=${GENTOO_OPT_ACTIVE_CXX:-none} fingerprint=${GENTOO_OPT_ACTIVE_FINGERPRINT} profile=${profile}"
    printf 'gentoo-optimization: %s\n' "${message}" >&2
    if [[ -n ${GENTOO_OPT_LOG_FILE-} ]]; then
        gentoo_opt_fixture_override_allowed || {
            gentoo_opt_error 'production dispatcher file logging is disabled; preserve Portage stderr as the authoritative build log'
            return 1
        }
        gentoo_opt_safe_absolute_path "${GENTOO_OPT_LOG_FILE}" || {
            gentoo_opt_error 'GENTOO_OPT_LOG_FILE must be a safe absolute path'; return 1;
        }
        gentoo_opt_allow_sandbox_write "${GENTOO_OPT_LOG_FILE}" || return 1
        printf '%s\n' "${message}" >> "${GENTOO_OPT_LOG_FILE}" || {
            gentoo_opt_error "cannot append optimization log: ${GENTOO_OPT_LOG_FILE}"; return 1;
        }
    fi
}

gentoo_opt_dispatch() {
    local mode=${GENTOO_OPT_MODE:-off} bolt_stage=${GENTOO_OPT_BOLT_STAGE:-off}
    if [[ ${PGO_INSTRUMENT:-0} == 1 || ${PGO_USE_IF_AVAILABLE:-0} == 1 ]]; then
        gentoo_opt_error 'legacy PGO marker requested; use a named GENTOO_OPT_MODE'
        return 1
    fi
    case ${mode} in
        off|'') mode=off ;;
        clang-ir-generate|clang-ir-use|clang-sample-use|gcc-generate|gcc-use|\
rust-generate|rust-use|go-use) ;;
        bolt-capture)
            [[ ${bolt_stage} == off || ${bolt_stage} == capture ]] || {
                gentoo_opt_error 'bolt-capture mode conflicts with GENTOO_OPT_BOLT_STAGE'; return 1;
            }
            bolt_stage=capture; mode=off
            ;;
        bolt-deploy)
            [[ ${bolt_stage} == off || ${bolt_stage} == deploy ]] || {
                gentoo_opt_error 'bolt-deploy mode conflicts with GENTOO_OPT_BOLT_STAGE'; return 1;
            }
            bolt_stage=deploy; mode=off
            ;;
        *) gentoo_opt_error "unknown GENTOO_OPT_MODE: ${mode}"; return 1 ;;
    esac
    case ${bolt_stage} in off|capture|deploy) ;; *) gentoo_opt_error "unknown GENTOO_OPT_BOLT_STAGE: ${bolt_stage}"; return 1 ;; esac
    case ${GENTOO_OPT_PROFILE_MAP_READY:-0} in
        0|1) ;;
        *) gentoo_opt_error 'GENTOO_OPT_PROFILE_MAP_READY must be exactly 0 or 1'; return 1 ;;
    esac
    case ${GENTOO_OPT_BOLT_GCC_READY:-0} in
        0|1) ;;
        *) gentoo_opt_error 'GENTOO_OPT_BOLT_GCC_READY must be exactly 0 or 1'; return 1 ;;
    esac
    # Preserve the requested selector (especially bolt-capture/bolt-deploy)
    # across Portage's saved environment and misc-functions subprocess.  The
    # normalized primary lane has its own variable.
    GENTOO_OPT_ACTIVE_MODE=${mode}
    GENTOO_OPT_ACTIVE_BOLT_STAGE=${bolt_stage}
    if [[ ${mode} == off && ${bolt_stage} == off &&
        ${GENTOO_OPT_PROFILE_MAP_READY:-0} != 1 &&
        ${GENTOO_OPT_BOLT_GCC_READY:-0} != 1 ]]; then
        return 0
    fi
    if [[ ${GENTOO_OPT_BOLT_GCC_READY:-0} == 1 &&
        ${bolt_stage} != capture && ${bolt_stage} != deploy ]]; then
        gentoo_opt_error 'bolt-gcc readiness requires an active BOLT capture/deploy stage'
        return 1
    fi
    gentoo_opt_detect_abi || return 1
    gentoo_opt_load_fingerprint || return 1
    if [[ ${bolt_stage} == capture || ${bolt_stage} == deploy ]]; then
        gentoo_opt_require_bolt_cache_root "${GENTOO_OPT_BOLT_CACHE_ROOT-}" || return 1
        [[ ${GENTOO_OPT_BOLT_EXPECTED_ELIGIBLE_COUNT-} =~ ^(0|[1-9][0-9]*)$ ]] || {
            gentoo_opt_error 'BOLT stage requires a nonnegative inventory-derived expected eligible count'
            return 1
        }
        gentoo_opt_safe_absolute_path "${GENTOO_OPT_BOLT_INVENTORY_PROOF-}" || {
            gentoo_opt_error 'BOLT stage requires a safe absolute inventory proof path'
            return 1
        }
        [[ -f ${GENTOO_OPT_BOLT_INVENTORY_PROOF} && ! -L ${GENTOO_OPT_BOLT_INVENTORY_PROOF} ]] || {
            gentoo_opt_error 'BOLT stage inventory proof is absent, non-regular, or symlinked'
            return 1
        }
    fi
    if [[ ${mode} != off ]]; then
        gentoo_opt_apply_primary_mode "${mode}" || return 1
    else
        [[ ${GENTOO_OPT_COMPILER_FAMILY-} == clang ||
            ${GENTOO_OPT_COMPILER_FAMILY-} == gcc ||
            ${GENTOO_OPT_COMPILER_FAMILY-} == rust ||
            ${GENTOO_OPT_COMPILER_FAMILY-} == go ]] || {
            gentoo_opt_error 'readiness-only mode requires an explicit supported compiler family'; return 1;
        }
        gentoo_opt_disable_ccache
        gentoo_opt_detect_compiler_family "${GENTOO_OPT_COMPILER_FAMILY}" || return 1
        GENTOO_OPT_ACTIVE_BACKEND=none
    fi
    gentoo_opt_apply_readiness_flags || return 1
    gentoo_opt_log_selection || return 1
}

gentoo_opt_depend_phase_preflight() {
    local mode=${GENTOO_OPT_MODE:-off} bolt_stage=${GENTOO_OPT_BOLT_STAGE:-off}
    local effective_bolt_stage=${bolt_stage}
    if [[ ${PGO_INSTRUMENT:-0} == 1 || ${PGO_USE_IF_AVAILABLE:-0} == 1 ]]; then
        if [[ ${EBUILD_PHASE-} == prerm || ${EBUILD_PHASE-} == postrm ]]; then
            # Portage may source a historical package environment during
            # removal.  Legacy markers must never affect non-build lifecycle
            # phases; discard them while retaining strict rejection in all
            # dependency/build evaluation paths.
            unset PGO_INSTRUMENT PGO_USE_IF_AVAILABLE
        else
        gentoo_opt_error 'legacy PGO marker requested during dependency evaluation'
        return 1
        fi
    fi
    case ${mode} in
        off|''|clang-ir-generate|clang-ir-use|clang-sample-use|gcc-generate|gcc-use|\
rust-generate|rust-use|go-use|bolt-capture|bolt-deploy) ;;
        *) gentoo_opt_error "unknown GENTOO_OPT_MODE during dependency evaluation: ${mode}"; return 1 ;;
    esac
    case ${bolt_stage} in
        off|capture|deploy) ;;
        *) gentoo_opt_error "unknown GENTOO_OPT_BOLT_STAGE during dependency evaluation: ${bolt_stage}"; return 1 ;;
    esac
    if [[ ${mode} == bolt-capture && ${bolt_stage} == deploy ]] ||
        [[ ${mode} == bolt-deploy && ${bolt_stage} == capture ]]; then
        gentoo_opt_error 'conflicting BOLT mode/stage during dependency evaluation'
        return 1
    fi
    [[ ${mode} != bolt-capture || ${bolt_stage} != off ]] || effective_bolt_stage=capture
    [[ ${mode} != bolt-deploy || ${bolt_stage} != off ]] || effective_bolt_stage=deploy
    case ${GENTOO_OPT_PROFILE_MAP_READY:-0} in
        0|1) ;;
        *) gentoo_opt_error 'invalid profile-map readiness marker during dependency evaluation'; return 1 ;;
    esac
    case ${GENTOO_OPT_BOLT_GCC_READY:-0} in
        0|1) ;;
        *) gentoo_opt_error 'invalid bolt-gcc readiness marker during dependency evaluation'; return 1 ;;
    esac
    if [[ ${GENTOO_OPT_BOLT_GCC_READY:-0} == 1 &&
        ${effective_bolt_stage} != capture && ${effective_bolt_stage} != deploy ]]; then
        gentoo_opt_error 'bolt-gcc readiness has no active BOLT stage during dependency evaluation'
        return 1
    fi
}

# The BOLT hook implementation supplies one or both named functions.  Keeping
# this dispatch separate makes the pre-strip phase boundary explicit and lets
# the hook implementation be tested without sourcing arbitrary package code.
gentoo_opt_bolt_wrapper_path() {
    local operation=$1 configured variable wrapper expected_wrapper
    case ${operation} in
        capture) variable=GENTOO_OPT_BOLT_CAPTURE_TOOL ;;
        deploy) variable=GENTOO_OPT_BOLT_DEPLOY_TOOL ;;
        *) return 1 ;;
    esac
    expected_wrapper=/usr/local/libexec/gentoo-optimization/bolt/${operation}-input.sh
    [[ ${operation} == deploy ]] && \
        expected_wrapper=/usr/local/libexec/gentoo-optimization/bolt/deploy-output.sh
    configured=${!variable-}
    if [[ -n ${configured} ]]; then
        gentoo_opt_safe_absolute_path "${configured}" || {
            gentoo_opt_error "${variable} must be a safe absolute path"; return 1;
        }
        if [[ ${configured} != "${expected_wrapper}" ]]; then
            gentoo_opt_fixture_override_allowed || {
                gentoo_opt_error "production BOLT ${operation} cannot override the installed wrapper"
                return 1
            }
        fi
        wrapper=${configured}
    else
        wrapper=${expected_wrapper}
    fi
    [[ -x ${wrapper} && -f ${wrapper} && ! -L ${wrapper} ]] || {
        gentoo_opt_error "BOLT ${operation} wrapper is unavailable or not executable: ${wrapper}"; return 1;
    }
    if [[ ${wrapper} == "${expected_wrapper}" ]] && \
        ! gentoo_opt_trusted_root_executable "${wrapper}"; then
        gentoo_opt_error "installed BOLT ${operation} wrapper is not a trusted root executable: ${wrapper}"
        return 1
    fi
    GENTOO_OPT_BOLT_WRAPPER=${wrapper}
}

gentoo_opt_run_bolt_wrapper() {
    local operation=$1 cache fingerprint
    gentoo_opt_safe_absolute_path "${ED-}" || {
        gentoo_opt_error 'BOLT hook requires ED to be a safe absolute staging path'; return 1;
    }
    [[ -d ${ED} ]] || {
        gentoo_opt_error "BOLT hook staging root does not exist: ${ED}"; return 1;
    }
    gentoo_opt_safe_absolute_path "${GENTOO_OPT_BOLT_CACHE_ROOT-}" || {
        gentoo_opt_error 'BOLT hook requires a safe absolute GENTOO_OPT_BOLT_CACHE_ROOT'; return 1;
    }
    cache=${GENTOO_OPT_BOLT_CACHE_ROOT}
    gentoo_opt_require_bolt_cache_root "${cache}" || return 1
    fingerprint=${GENTOO_OPT_ACTIVE_FINGERPRINT}
    gentoo_opt_allow_sandbox_write "${cache}/locks/${fingerprint}.lock" || return 1
    case ${operation} in
        capture)
            gentoo_opt_allow_sandbox_write "${cache}/inputs/${fingerprint}" || return 1
            gentoo_opt_allow_sandbox_write "${cache}/inputs/${fingerprint}.partial" || return 1
            ;;
        deploy)
            gentoo_opt_allow_sandbox_write "${cache}/diagnostics/${fingerprint}" || return 1
            ;;
    esac
    gentoo_opt_bolt_wrapper_path "${operation}" || return 1
    "${GENTOO_OPT_BOLT_WRAPPER}" --ed "${ED}" \
        --cache-root "${cache}" --fingerprint "${fingerprint}" \
        --expected-eligible-count "${GENTOO_OPT_BOLT_EXPECTED_ELIGIBLE_COUNT}" \
        --inventory-proof "${GENTOO_OPT_BOLT_INVENTORY_PROOF}" \
        --readelf /usr/bin/readelf --objcopy /usr/bin/objcopy
}

gentoo_opt_post_src_install() {
    case ${GENTOO_OPT_ACTIVE_BOLT_STAGE:-off} in
        off) return 0 ;;
        capture)
            gentoo_opt_run_bolt_wrapper capture
            ;;
        deploy)
            gentoo_opt_run_bolt_wrapper deploy
            ;;
    esac
}

gentoo_opt_invalidate_installed_marker() {
    local builddir=${PORTAGE_BUILDDIR-} portage_tmp=${PORTAGE_TMPDIR-} marker
    gentoo_opt_safe_absolute_path "${builddir}" || {
        gentoo_opt_error 'cannot invalidate .installed: unsafe or missing PORTAGE_BUILDDIR'
        return 1
    }
    gentoo_opt_safe_absolute_path "${portage_tmp}" || {
        gentoo_opt_error 'cannot invalidate .installed: unsafe or missing PORTAGE_TMPDIR'
        return 1
    }
    [[ ${builddir} == "${portage_tmp%/}/portage/"* ]] || {
        gentoo_opt_error 'cannot invalidate .installed outside PORTAGE_TMPDIR/portage'
        return 1
    }
    marker=${builddir}/.installed
    if [[ -L ${marker} || ( -e ${marker} && ! -f ${marker} ) ]]; then
        gentoo_opt_error 'cannot invalidate a non-regular or symlinked .installed marker'
        return 1
    fi
    if [[ -e ${marker} ]]; then
        rm -f -- "${marker}" || {
            gentoo_opt_error 'failed to remove the Portage .installed marker'
            return 1
        }
    fi
    [[ ! -e ${marker} && ! -L ${marker} ]]
}

gentoo_opt_post_install_abort() {
    local message=$1
    if ! gentoo_opt_invalidate_installed_marker; then
        gentoo_opt_abort "${message}; .installed invalidation also failed" || return 1
    fi
    gentoo_opt_abort "${message}" || return 1
}

# Production capture/deployment is invoked by the repository-wide
# metadata/install-qa-check.d hook.  Portage runs that stable interface after
# the package's post_src_install and before estrip.  A direct post_src_install
# wrapper is retained only for the unset-EBUILD_PHASE hermetic emulator.
if [[ -z ${EBUILD_PHASE-} ]]; then
    gentoo_opt_current_post_src_install_definition=''
    if declare -F post_src_install >/dev/null; then
        gentoo_opt_current_post_src_install_definition=$(declare -f post_src_install)
    fi
    if [[ ${gentoo_opt_current_post_src_install_definition} != \
        *gentoo-optimization-dispatcher-post-hook* ]]; then
        unset -f gentoo_opt_previous_post_src_install 2>/dev/null || :
        if [[ -n ${gentoo_opt_current_post_src_install_definition} ]]; then
            gentoo_opt_previous_post_src_install_definition=${gentoo_opt_current_post_src_install_definition/#post_src_install/gentoo_opt_previous_post_src_install}
            eval "${gentoo_opt_previous_post_src_install_definition}"
            unset gentoo_opt_previous_post_src_install_definition
        fi
        post_src_install() {
            : gentoo-optimization-dispatcher-post-hook
            if declare -F gentoo_opt_previous_post_src_install >/dev/null; then
                if ! gentoo_opt_previous_post_src_install "$@"; then
                    gentoo_opt_post_install_abort 'the pre-existing post_src_install hook failed' || return 1
                fi
            fi
            if ! gentoo_opt_post_src_install "$@"; then
                gentoo_opt_post_install_abort 'the BOLT post_src_install transaction failed' || return 1
            fi
        }
    fi
    unset gentoo_opt_current_post_src_install_definition
fi

case ${EBUILD_PHASE-} in
    ''|setup|unpack|prepare|configure|compile|test|install)
        if ! gentoo_opt_dispatch; then
            gentoo_opt_abort 'optimization mode dispatch failed' || return 1
        fi
        ;;
    *)
        if ! gentoo_opt_depend_phase_preflight; then
            gentoo_opt_abort 'optimization mode preflight failed during a non-build phase' || return 1
        fi
        ;;
esac
