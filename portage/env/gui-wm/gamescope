post_src_prepare() {
grep -lZE "std::atomic<std::shared_ptr<.*>>" -r src/ | xargs -0 -r sed -i 's/std::atomic<std::shared_ptr<\([^>]*\)>>/std::shared_ptr<\1>/g'
local ATOMIC_PTRS="m_pRelativePointer m_pApplicationCursor"

for var in $ATOMIC_PTRS; do
        # FIX: keep the variable name ($var) in the replacement
        grep -lR "$var" src/ | xargs -r sed -i -E "s/$var\.load\s*\(\s*\)/$var/g"
        
        # Replace .exchange(val) with an assignment expression ($var = val)
        grep -lR "$var" src/ | xargs -r sed -i -E "s/$var\.exchange\s*\(([^)]+)\)/($var = \1)/g"
        
        # Replace std::atomic_store calls
        grep -lR "$var" src/ | xargs -r sed -i -E "s/std::atomic_store\s*\(&$var,\s*([^)]+)\)/($var = \1)/g"
    done
grep -lZE "std::shared_ptr<void>(nullptr)" -r src/ | xargs -0 -r sed -i 's/std::shared_ptr<void>(nullptr)/nullptr/g'
if [ -f src/steamcompmgr.cpp ]; then
        sed -i 's/vblank && g_bForceRepaint = false/vblank \&\& g_bForceRepaint.exchange(false)/g' src/steamcompmgr.cpp
    fi
}
