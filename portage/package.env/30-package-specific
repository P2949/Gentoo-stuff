media-libs/libjxl highway-noavx512.conf no-hidden-visibility.conf
dev-util/colm libstdcxx-headers.conf
dev-util/ragel libstdcxx-headers.conf
gui-wm/gamescope clang-libstdcxx.conf
gui-wm/hyprland O3-thin-lto-no-libs.conf
media-gfx/gimp gimp.conf
dev-tcltk/tix tix-gnu89.conf
sys-fs/xfsprogs mount-defines.conf
dev-util/source-highlight no-hidden-visibility.conf
# ujson's extension build emits *.so-opt.ld.yaml beside the module when
# optimization remarks are enabled; Portage rejects those files as stray
# top-level site-packages payload. Keep the optimization policy narrow while
# removing only that generated-record side effect.
dev-python/ujson no-opt-remarks.conf
# Preserve established public C++ exports in WebKit's JavaScriptCore/WTF
# DSOs while retaining the rest of the optimization policy.
net-libs/webkit-gtk no-hidden-visibility.conf
# libsecret's installed DSO exports its internal helper ABI; avoid hiding
# those established symbols during the optimized rebuild.
app-crypt/libsecret no-polly-no-lto-no-bsymbolic.conf
# Java: ccache and sandboxing break the build; OpenJDK rejects Polly flags.
dev-java/openjdk unsafe-no-ccache-no-sandbox.conf no-polly.conf
gui-libs/hyprutils O2.conf
