# shellcheck shell=bash
# Installed as the lexically last sysadmin Portage install-QA override. Portage
# sources this after package post_src_install and all earlier QA normalization,
# immediately before its remaining compression/metadata/strip pipeline.

# Portage may invoke install-QA from an instrumented bash process after it has
# filtered phase-local profiling variables.  Keep the guard/capture boundary
# from creating an implicit default.profraw in ED while it snapshots the staged
# tree.  Explicit profile-wave workloads set their own absolute pattern.
export LLVM_PROFILE_FILE=/dev/null

gentoo_opt_hook_abort() {
    local message=$1 builddir=${PORTAGE_BUILDDIR-} portage_tmp=${PORTAGE_TMPDIR-}
    local marker
    if [[ ${builddir} == /* && ${builddir} != / && ${portage_tmp} == /* &&
        ${portage_tmp} != / && ${builddir} == "${portage_tmp%/}/portage/"* ]]; then
        marker=${builddir}/.installed
        if [[ ! -L ${marker} && ( ! -e ${marker} || -f ${marker} ) ]]; then
            /usr/bin/rm -f -- "${marker}" || :
        fi
    fi
    if declare -F die >/dev/null 2>&1; then
        die "gentoo-optimization: ${message}"
    fi
    printf 'gentoo-optimization: %s\n' "${message}" >&2
    return 1
}

# Check replacement DSOs before Portage strips or admits them.  This is an
# ABI safety net for ordinary package installs, independent of BOLT mode.
qa_implementation=${BASH_SOURCE[0]}
qa_generation=${qa_implementation%/qa/*}
test_helpers=0
if [[ ${GENTOO_OPT_TEST_MODE:-0} == 1 || -n ${GENTOO_OPT_ABI_GUARD:-} || -n ${GENTOO_OPT_INSTRUMENTATION_CHECKER:-} ]]; then
    [[ -z ${EBUILD_PHASE-} ]] || \
        gentoo_opt_hook_abort 'test-only ABI guard override is forbidden in an ebuild phase'
    [[ ${GENTOO_OPT_TEST_MODE:-0} == 1 && -n ${GENTOO_OPT_ABI_GUARD:-} ]] || \
        gentoo_opt_hook_abort 'incomplete ABI guard fixture override'
    [[ ${GENTOO_OPT_ABI_GUARD} == /* && -x ${GENTOO_OPT_ABI_GUARD} ]] || \
        gentoo_opt_hook_abort 'ABI guard fixture path must be absolute and executable'
    [[ -n ${GENTOO_OPT_INSTRUMENTATION_CHECKER:-} && ${GENTOO_OPT_INSTRUMENTATION_CHECKER} == /* &&
        -x ${GENTOO_OPT_INSTRUMENTATION_CHECKER} ]] || \
        gentoo_opt_hook_abort 'instrumentation checker fixture path must be absolute and executable'
    test_helpers=1
fi
if (( test_helpers == 0 )); then
    if [[ ${qa_generation} == "${qa_implementation}" ]]; then
        qa_generation=/usr/local/libexec/gentoo-optimization
    fi
    [[ ${qa_generation} == /* && -d ${qa_generation} ]] || \
        gentoo_opt_hook_abort 'QA implementation generation root is unavailable'
    qa_libexec=${qa_generation}
    [[ ${qa_generation##*/} == gentoo-optimization ]] || qa_libexec=${qa_generation}/libexec
    abi_guard=${qa_libexec}/scripts/optimization/verify/abi-guard.py
    instrumentation_checker=${qa_libexec}/scripts/optimization/lib/check-staged-instrumentation.py
else
    abi_guard=${GENTOO_OPT_ABI_GUARD}
    instrumentation_checker=${GENTOO_OPT_INSTRUMENTATION_CHECKER}
fi
[[ -x ${abi_guard} ]] || gentoo_opt_hook_abort 'production ABI guard helper is missing'
# Portage keeps ED/ROOT as shell locals while sourcing install-QA hooks; pass
# those authenticated roots explicitly to the standalone verifier rather than
# relying on child-process export semantics.
hook_ed=${ED:-${D:-$(builtin pwd -P)}}
hook_root=${ROOT:-${EROOT:-/}}
# Instrumented helper processes may leave an implicit LLVM profile in ED even
# when the transaction discards runtime output.  It is transient orchestration
# residue, never a package payload, and must be removed before collision QA.
if [[ ${LLVM_PROFILE_FILE:-} == /dev/null && -f ${hook_ed}/default.profraw ]]; then
    /usr/bin/rm -f -- "${hook_ed}/default.profraw" || \
        gentoo_opt_hook_abort 'unable to remove transient default.profraw residue'
fi
/usr/bin/env ED="${hook_ed}" ROOT="${hook_root}" "${abi_guard}" || \
    gentoo_opt_hook_abort 'replacement DSO failed exported-ABI guard'
unset hook_ed hook_root

# Instrumented ELF payloads are only admissible for an explicitly targeted
# generation transaction.  Ordinary/off/profile-use installs must never admit
# generation markers, even when runtime output was redirected to /dev/null.
[[ -x ${instrumentation_checker} ]] || gentoo_opt_hook_abort 'staged instrumentation checker is missing'
instrumentation_rc=0
"${instrumentation_checker}" "${ED:-${D:-.}}" || instrumentation_rc=$?
if (( instrumentation_rc == 20 || instrumentation_rc == 21 )); then
    gentoo_opt_hook_abort 'staged ELF instrumentation inspection failed'
elif (( instrumentation_rc == 10 )); then
    if [[ ${GENTOO_OPT_DEINSTRUMENT:-0} == 1 ]]; then
        # A de-instrumentation transaction intentionally admits old markers,
        # but only after authenticating the exact target and reviewed plan.
        # The ABI guard remains active with its instrumentation-only filter.
        deinstrument_marker=/var/lib/gentoo-optimization/state/deinstrument.pending
        if [[ ${GENTOO_OPT_TEST_MODE:-0} == 1 && -n ${GENTOO_OPT_DEINSTRUMENT_MARKER:-} ]]; then
            deinstrument_marker=${GENTOO_OPT_DEINSTRUMENT_MARKER}
        fi
        [[ -s ${deinstrument_marker} ]] || \
            gentoo_opt_hook_abort 'de-instrumentation marker is empty'
        [[ -n ${GENTOO_OPT_TARGET_CPV:-} && ${GENTOO_OPT_TARGET_CPV} == "${CATEGORY-}/${PF-}" ]] || \
            gentoo_opt_hook_abort 'de-instrumentation target CPV mismatch'
        [[ -n ${GENTOO_OPT_DEINSTRUMENT_PLAN:-} && -f ${GENTOO_OPT_DEINSTRUMENT_PLAN} &&
           -n ${GENTOO_OPT_DEINSTRUMENT_PLAN_SHA256:-} ]] || \
            gentoo_opt_hook_abort 'de-instrumentation plan identity is missing'
        actual_plan_sha256=$(/usr/bin/sha256sum -- "${GENTOO_OPT_DEINSTRUMENT_PLAN}" | /usr/bin/awk '{print $1}')
        [[ ${actual_plan_sha256} == "${GENTOO_OPT_DEINSTRUMENT_PLAN_SHA256}" ]] || \
            gentoo_opt_hook_abort 'de-instrumentation plan digest mismatch'
        /usr/bin/jq -e --arg plan "${GENTOO_OPT_DEINSTRUMENT_PLAN}" \
            --arg sha "${GENTOO_OPT_DEINSTRUMENT_PLAN_SHA256}" \
            --arg cpv "${GENTOO_OPT_TARGET_CPV}" \
            '(.schema == "deinstrument-pending-v1") and (.state == "armed") and
             (.plan == $plan) and (.plan_sha256 == $sha) and
             ((.cpvs // []) | index($cpv) != null)' \
            "${deinstrument_marker}" >/dev/null 2>&1 || \
            gentoo_opt_hook_abort 'de-instrumentation marker authority mismatch'
        /usr/bin/jq -e --arg cpv "${GENTOO_OPT_TARGET_CPV}" \
            '[.batches[]?.cpvs[]?] | index($cpv) != null' \
            "${GENTOO_OPT_DEINSTRUMENT_PLAN}" >/dev/null 2>&1 || \
            gentoo_opt_hook_abort 'de-instrumentation target is absent from reviewed plan'
        printf 'gentoo-optimization: admitting instrumentation for de-instrumentation cleanup\n' >&2
    elif [[ ${GENTOO_OPT_MODE:-off} != *-generate ||
          -z ${GENTOO_OPT_TARGET_CPV:-} ||
          ${GENTOO_OPT_TARGET_CPV} != "${CATEGORY-}/${PF-}" ]]; then
        # A QA_PREBUILT ebuild has no compilation boundary at which the
        # project can remove upstream instrumentation.  Admit that payload
        # only as an explicitly terminal prebuilt artifact; it remains
        # outside PGO/BOLT authority and is recorded by lane classification.
        prebuilt_terminal=0
        case ${CATEGORY-}/${PF-} in
            app-autodesk/adp-desktop-sdk-*|app-autodesk/adsk-licensing-*|dev-games/unityhub-*|media-sound/spotify-*) prebuilt_terminal=1 ;;
        esac
        if [[ -z ${QA_PREBUILT-} && ${prebuilt_terminal} -ne 1 ]]; then
            gentoo_opt_hook_abort 'unauthorized instrumentation in staged payload'
        fi
        printf 'gentoo-optimization: retaining instrumented QA_PREBUILT payload outside optimization authority\n' >&2
        unset prebuilt_terminal
    fi
elif (( instrumentation_rc != 0 )); then
    gentoo_opt_hook_abort 'staged instrumentation checker failed'
fi
unset instrumentation_rc

requested_stage=off
case ${GENTOO_OPT_MODE:-off} in
    bolt-capture) requested_stage=capture ;;
    bolt-deploy) requested_stage=deploy ;;
    *)
        case ${GENTOO_OPT_BOLT_STAGE:-off} in
            off|'') ;;
            capture|deploy) requested_stage=${GENTOO_OPT_BOLT_STAGE} ;;
            *) gentoo_opt_hook_abort 'invalid requested BOLT stage at the pre-strip boundary' ;;
        esac
        ;;
esac

active_stage=${GENTOO_OPT_ACTIVE_BOLT_STAGE-}
if [[ -z ${active_stage} ]]; then
    [[ ${requested_stage} == off ]] || \
        gentoo_opt_hook_abort 'active BOLT dispatcher state was lost before the pre-strip boundary'
    active_stage=off
fi
[[ ${active_stage} == "${requested_stage}" ]] || \
    gentoo_opt_hook_abort \
        "requested/active BOLT stage mismatch (${requested_stage}/${active_stage})"

case ${active_stage} in
    off) ;;
    capture|deploy)
        declare -F gentoo_opt_post_src_install >/dev/null || \
            gentoo_opt_hook_abort 'strict BOLT transaction function is unavailable'
        declare -F gentoo_opt_post_install_abort >/dev/null || \
            gentoo_opt_hook_abort 'strict BOLT marker invalidator is unavailable'
        if ! gentoo_opt_post_src_install; then
            gentoo_opt_post_install_abort \
                'the pre-strip BOLT install-QA transaction failed' || \
                gentoo_opt_hook_abort 'failed to abort the BOLT transaction'
        fi
        ;;
    *) gentoo_opt_hook_abort 'unknown active BOLT stage at the pre-strip boundary' ;;
esac

unset active_stage requested_stage
