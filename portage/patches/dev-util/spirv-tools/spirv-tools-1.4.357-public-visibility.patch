--- a/source/CMakeLists.txt
+++ b/source/CMakeLists.txt
@@
-set_target_properties(${SPIRV_TOOLS}-shared PROPERTIES CXX_VISIBILITY_PRESET hidden)
+# The shared target is the installed public C++ library on Gentoo.  Keep its
+# complete ABI visible; the global optimization profile already supplies the
+# other code-generation controls and the replacement-DSO guard authenticates
+# the resulting export set.
+set_target_properties(${SPIRV_TOOLS}-shared PROPERTIES CXX_VISIBILITY_PRESET default)
