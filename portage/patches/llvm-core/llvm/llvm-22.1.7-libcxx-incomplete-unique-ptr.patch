@@ -94,6 +94,8 @@
               OffsetToUnitTy UnitFromOffset, dwarf::FormParams Format,
               llvm::endianness Endianess);
 
+  ~CompileUnit();
+
   /// Returns stage of overall processing.
   Stage getStage() const { return Stage; }
 
