From: Gentoo system-wide optimization project
Subject: [PATCH] BOLT: permit standalone tools to use the LLVM dylib

Gentoo's llvm-core/llvm package builds LLVM_LINK_LLVM_DYLIB=ON and installs
the monolithic, slotted LLVM shared library.  Most component archives are
intentionally excluded from its distribution.  A standalone BOLT build
therefore cannot satisfy the forced component-static links below.

Honor the LLVM package's exported LLVM_LINK_LLVM_DYLIB setting throughout
the BOLT library and installed-tool link closure.  BOLT's own libraries
remain static and private to the executables; this changes only their LLVM
linkage.  Unit tests retain their upstream static-link override because this
package does not build or install them.

--- a/bolt/lib/Core/CMakeLists.txt
+++ b/bolt/lib/Core/CMakeLists.txt
@@ -38,7 +38,6 @@ add_llvm_library(LLVMBOLTCore
   Relocation.cpp
 
   NO_EXPORT
-  DISABLE_LLVM_LINK_LLVM_DYLIB
   LINK_LIBS
   ${LLVM_PTHREAD_LIB}
   )
--- a/bolt/lib/Passes/CMakeLists.txt
+++ b/bolt/lib/Passes/CMakeLists.txt
@@ -50,7 +50,6 @@ add_llvm_library(LLVMBOLTPasses
   RetpolineInsertion.cpp
 
   NO_EXPORT
-  DISABLE_LLVM_LINK_LLVM_DYLIB
 
   LINK_LIBS
   ${LLVM_PTHREAD_LIB}
--- a/bolt/lib/Profile/CMakeLists.txt
+++ b/bolt/lib/Profile/CMakeLists.txt
@@ -8,7 +8,6 @@ add_llvm_library(LLVMBOLTProfile
   YAMLProfileWriter.cpp
 
   NO_EXPORT
-  DISABLE_LLVM_LINK_LLVM_DYLIB
 
   LINK_COMPONENTS
   Demangle
--- a/bolt/lib/Rewrite/CMakeLists.txt
+++ b/bolt/lib/Rewrite/CMakeLists.txt
@@ -29,7 +29,6 @@ add_llvm_library(LLVMBOLTRewrite
   GNUPropertyRewriter.cpp
 
   NO_EXPORT
-  DISABLE_LLVM_LINK_LLVM_DYLIB
 
   LINK_LIBS
   ${LLVM_PTHREAD_LIB}
--- a/bolt/lib/RuntimeLibs/CMakeLists.txt
+++ b/bolt/lib/RuntimeLibs/CMakeLists.txt
@@ -12,7 +12,6 @@ add_llvm_library(LLVMBOLTRuntimeLibs
   InstrumentationRuntimeLibrary.cpp
 
   NO_EXPORT
-  DISABLE_LLVM_LINK_LLVM_DYLIB
   )
 
 target_link_libraries(LLVMBOLTRuntimeLibs
--- a/bolt/lib/Target/AArch64/CMakeLists.txt
