   X86CommonTableGen
--- a/bolt/lib/Utils/CMakeLists.txt
+++ b/bolt/lib/Utils/CMakeLists.txt
@@ -44,7 +44,6 @@ add_llvm_library(LLVMBOLTUtils
   ${version_inc}
 
   NO_EXPORT
-  DISABLE_LLVM_LINK_LLVM_DYLIB
 
