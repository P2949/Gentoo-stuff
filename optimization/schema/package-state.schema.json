{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentoo-optimization.invalid/schema/package-state.schema.json",
  "title": "Gentoo optimization package state",
  "description": "A versioned installed CPV with per-component/per-ABI build identities and CPV-level coverage aggregates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "cpv",
    "cp",
    "repository",
    "slot",
    "subslot",
    "abis",
    "ebuild_sha256",
    "use_flags",
    "build_identities",
    "aggregate",
    "final_status",
    "terminal_reason",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "package"},
    "cpv": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+_.-]+/[A-Za-z0-9+_.-]+-[0-9][A-Za-z0-9+_.-]*(?:-r[0-9]+)?$"
    },
    "cp": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+_.-]+/[A-Za-z0-9+_.-]+$"
    },
    "repository": {"type": "string", "minLength": 1},
    "slot": {"type": "string", "minLength": 1},
    "subslot": {"type": "string", "minLength": 1},
    "abis": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["amd64", "x86"]}
    },
    "ebuild_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "use_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "build_identities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/build_identity"}
    },
    "aggregate": {"$ref": "#/$defs/aggregate"},
    "final_status": {"$ref": "#/$defs/final_status"},
    "terminal_reason": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/terminal_reason"}]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "terminal_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "evidence", "reviewed"],
      "properties": {
        "reason_code": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reviewed": {"const": true}
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "path", "realpath", "sha256", "version", "profile_format"],
      "properties": {
        "family": {"enum": ["clang", "gcc", "rust", "go", "native"]},
        "path": {"type": "string", "pattern": "^/"},
        "realpath": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string", "minLength": 1},
        "profile_format": {"type": "string", "minLength": 1}
      }
    },
    "pgo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility",
        "mode",
        "generation_id",
        "profile_path",
        "profile_sha256",
        "profile_valid",
        "build_verified",
        "terminal_reason",
        "status"
      ],
      "properties": {
        "eligibility": {"enum": ["eligible", "not-applicable", "terminal-exclusion"]},
        "mode": {
          "enum": [
            "clang-ir",
            "clang-sample",
            "gcc-gcov",
            "rust-llvm-ir",
            "go-pprof",
            "ebuild-native",
            "kernel-autofdo",
            "not-applicable"
          ]
        },
        "generation_id": {"type": ["string", "null"]},
        "profile_path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^/"}
          ]
        },
        "profile_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "profile_valid": {"type": "boolean"},
        "build_verified": {"type": "boolean"},
        "terminal_reason": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/terminal_reason"}]
        },
        "status": {
          "enum": [
            "pending",
            "training",
            "profiled",
            "optimized",
            "not-applicable",
            "terminal-exclusion",
            "failed"
          ]
        }
      }
    },
    "build_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "component_kind",
        "abi",
        "target_triple",
        "build_backend",
        "compiler",
        "fingerprint",
        "pgo"
      ],
      "properties": {
        "component_id": {"type": "string", "pattern": "^[A-Za-z0-9+_.@-]+$"},
        "component_kind": {
          "enum": ["native", "rust", "go", "kernel", "jvm", "script-data", "other"]
        },
        "abi": {"enum": ["amd64", "x86", "none"]},
        "target_triple": {"type": ["string", "null"]},
        "build_backend": {
          "enum": [
            "clang-ir",
            "gcc-gcov",
            "rust-llvm-ir",
            "go-pprof",
            "ebuild-native",
            "clang-sample",
            "kernel-autofdo",
            "not-applicable"
          ]
        },
        "compiler": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/compiler"}]
        },
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "pgo": {"$ref": "#/$defs/pgo"}
      }
    },
    "lane_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_count",
        "optimized_count",
        "excluded_count",
        "not_applicable_count",
        "pending_count",
        "failed_count",
        "status"
      ],
      "properties": {
        "eligible_count": {"type": "integer", "minimum": 0},
        "optimized_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "not_applicable_count": {"type": "integer", "minimum": 0},
        "pending_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "status": {
          "enum": [
            "pending",
            "optimized",
            "optimized-with-exclusions",
            "not-applicable",
            "terminal-exclusion",
            "failed"
          ]
        }
      }
    },
    "bolt_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "optimized_count",
        "excluded_count",
        "not_applicable_count",
        "pending_count",
        "failed_count",
        "status"
      ],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "optimized_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "not_applicable_count": {"type": "integer", "minimum": 0},
        "pending_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "status": {
          "enum": [
            "pending",
            "optimized",
            "optimized-with-exclusions",
            "not-applicable",
            "terminal-exclusion",
            "failed"
          ]
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_count", "artifact_count", "pgo", "bolt"],
      "properties": {
        "component_count": {"type": "integer", "minimum": 1},
        "artifact_count": {"type": "integer", "minimum": 0},
        "pgo": {"$ref": "#/$defs/lane_aggregate"},
        "bolt": {"$ref": "#/$defs/bolt_aggregate"}
      }
    },
    "final_status": {
      "enum": [
        "pending",
        "optimized",
        "optimized-with-exclusions",
        "not-applicable",
        "terminal-exclusion",
        "failed"
      ]
    }
  }
}
