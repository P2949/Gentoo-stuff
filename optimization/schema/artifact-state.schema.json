{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentoo-optimization.invalid/schema/artifact-state.schema.json",
  "title": "Gentoo optimization artifact state",
  "description": "One canonical installed artifact linked to an exact package component identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "owner_cpv",
    "owner_cp",
    "owner_component_id",
    "owner_component_fingerprint",
    "kind",
    "format",
    "installed_path",
    "canonical_path",
    "content_sha256",
    "size",
    "abi",
    "elf",
    "setuid",
    "setgid",
    "file_capabilities",
    "hardlink_paths",
    "symlink_paths",
    "bolt",
    "final_status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "artifact"},
    "owner_cpv": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+_.-]+/[A-Za-z0-9+_.-]+-[0-9][A-Za-z0-9+_.-]*(?:-r[0-9]+)?$"
    },
    "owner_cp": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+_.-]+/[A-Za-z0-9+_.-]+$"
    },
    "owner_component_id": {"type": "string", "pattern": "^[A-Za-z0-9+_.@-]+$"},
    "owner_component_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kind": {
      "enum": [
        "elf",
        "static-archive",
        "relocatable-object",
        "kernel-module",
        "ebpf",
        "gpu-object",
        "firmware",
        "bytecode",
        "script",
        "data"
      ]
    },
    "format": {"type": "string", "minLength": 1},
    "installed_path": {"type": "string", "pattern": "^/"},
    "canonical_path": {"type": "string", "pattern": "^/"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 0},
    "abi": {
      "oneOf": [
        {"type": "null"},
        {"enum": ["amd64", "x86", "other"]}
      ]
    },
    "elf": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/elf"}
      ]
    },
    "setuid": {"type": "boolean"},
    "setgid": {"type": "boolean"},
    "file_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "hardlink_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "symlink_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "bolt": {"$ref": "#/$defs/bolt"},
    "final_status": {"$ref": "#/$defs/artifact_final_status"}
  },
  "$defs": {
    "terminal_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "evidence", "reviewed"],
      "properties": {
        "reason_code": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reviewed": {"const": true}
      }
    },
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "type",
        "machine",
        "build_id",
        "text_sha256",
        "has_symbols",
        "has_text_relocations",
        "has_executable_sections",
        "interpreter",
        "needed"
      ],
      "properties": {
        "class": {"enum": [32, 64]},
        "type": {"enum": ["EXEC", "DYN", "REL", "CORE", "OTHER"]},
        "machine": {"type": "string", "minLength": 1},
        "build_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]+$"}
          ]
        },
        "text_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "has_symbols": {"type": "boolean"},
        "has_text_relocations": {"type": "boolean"},
        "has_executable_sections": {"type": "boolean"},
        "interpreter": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^/"}
          ]
        },
        "needed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "bolt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligibility",
        "terminal_reason",
        "profile_samples",
        "profile_stale_percent",
        "output_path",
        "installed_has_bolt_note",
        "status"
      ],
      "properties": {
        "eligibility": {"enum": ["eligible", "not-applicable", "terminal-exclusion"]},
        "terminal_reason": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/terminal_reason"}]
        },
        "profile_samples": {"type": "integer", "minimum": 0},
        "profile_stale_percent": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0, "maximum": 100}
          ]
        },
        "output_path": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^/"}
          ]
        },
        "installed_has_bolt_note": {"type": "boolean"},
        "status": {
          "enum": [
            "pending",
            "captured",
            "profiled",
            "optimized",
            "not-applicable",
            "terminal-exclusion",
            "failed"
          ]
        }
      }
    },
    "artifact_final_status": {
      "enum": ["pending", "optimized", "not-applicable", "terminal-exclusion", "failed"]
    }
  }
}
