{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentoo-optimization.invalid/schema/artifact-state.schema.json",
  "title": "Gentoo optimization artifact state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "owner_cpv",
    "package_fingerprint",
    "installed_path",
    "canonical_path",
    "elf_class",
    "elf_type",
    "machine",
    "abi",
    "build_id",
    "text_sha256",
    "has_symbols",
    "has_text_relocations",
    "setuid",
    "setgid",
    "file_capabilities",
    "hardlink_paths",
    "symlink_paths",
    "bolt_eligibility",
    "terminal_reason",
    "bolt_profile_samples",
    "bolt_profile_stale_percent",
    "bolt_output_path",
    "installed_has_bolt_note",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "artifact"},
    "owner_cpv": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "package_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "installed_path": {"type": "string", "pattern": "^/"},
    "canonical_path": {"type": "string", "pattern": "^/"},
    "elf_class": {"enum": [32, 64]},
    "elf_type": {"enum": ["EXEC", "DYN", "REL", "CORE", "OTHER"]},
    "machine": {"type": "string", "minLength": 1},
    "abi": {"enum": ["amd64", "x86", "other"]},
    "build_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9A-Fa-f]+$"}
      ]
    },
    "text_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "has_symbols": {"type": "boolean"},
    "has_text_relocations": {"type": "boolean"},
    "setuid": {"type": "boolean"},
    "setgid": {"type": "boolean"},
    "file_capabilities": {"type": "array", "items": {"type": "string"}},
    "hardlink_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "symlink_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "bolt_eligibility": {"enum": ["eligible", "not-applicable", "terminal-exclusion"]},
    "terminal_reason": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code", "evidence", "reviewed"],
          "properties": {
            "reason_code": {"type": "string", "minLength": 1},
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "reviewed": {"const": true}
          }
        }
      ]
    },
    "bolt_profile_samples": {"type": "integer", "minimum": 0},
    "bolt_profile_stale_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "bolt_output_path": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^/"}
      ]
    },
    "installed_has_bolt_note": {"type": "boolean"},
    "status": {
      "enum": ["pending", "captured", "profiled", "optimized", "not-applicable", "terminal-exclusion", "failed"]
    }
  }
}
