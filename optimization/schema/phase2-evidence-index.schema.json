{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gentoo-optimization.invalid/schema/phase2-evidence-index-v1.json",
  "title": "Gentoo optimization Phase 2 evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "phase",
    "production",
    "run_id",
    "component_state_run",
    "repository",
    "policy",
    "sources",
    "plan",
    "tools",
    "test_run",
    "evidence_manifest",
    "component_states",
    "aggregate"
  ],
  "properties": {
    "schema": {"const": "gentoo-optimization-phase2-evidence-index-v1"},
    "phase": {"const": 2},
    "production": {"type": "boolean"},
    "run_id": {"$ref": "#/$defs/safe_id"},
    "component_state_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "path", "stat"],
      "properties": {
        "run_id": {"$ref": "#/$defs/safe_id"},
        "path": {"type": "string", "pattern": "^/"},
        "stat": {"$ref": "#/$defs/stat_identity"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "commit", "tree", "source_tree_listing_sha256", "head_ref", "clean"],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "commit": {"$ref": "#/$defs/git_oid"},
        "tree": {"$ref": "#/$defs/git_oid"},
        "source_tree_listing_sha256": {"$ref": "#/$defs/sha256"},
        "head_ref": {"type": ["string", "null"]},
        "clean": {"const": true}
      }
    },
    "policy": {"$ref": "#/$defs/file_identity"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_identity"}
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "claims"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "marker_line", "checkbox_lines", "checkbox_sha256", "source_sha256"],
            "properties": {
              "claim_id": {"$ref": "#/$defs/safe_name"},
              "marker_line": {"type": "integer", "minimum": 1},
              "checkbox_lines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
              "checkbox_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
              "source_sha256": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    },
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool_identity"}},
    "test_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "results", "summary", "provenance", "boot_id", "mode", "totals", "required_passes"],
      "properties": {
        "driver": {"$ref": "#/$defs/file_identity"},
        "results": {"$ref": "#/$defs/file_identity"},
        "summary": {"$ref": "#/$defs/file_identity"},
        "provenance": {"$ref": "#/$defs/file_identity"},
        "boot_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "mode": {"type": "string", "minLength": 1},
        "totals": {"$ref": "#/$defs/test_totals"},
        "required_passes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "entry_count", "entries_sha256", "entries"],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "entry_count": {"type": "integer", "minimum": 1},
        "entries_sha256": {"$ref": "#/$defs/sha256"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tree_entry"}}
      }
    },
    "component_states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "identity", "tested_code_commit", "tested_tree", "source_tree_listing_sha256", "test_run_provenance_sha256", "test_names", "external_evidence", "totals"],
        "properties": {
          "name": {"$ref": "#/$defs/safe_name"},
          "identity": {"$ref": "#/$defs/file_identity"},
          "tested_code_commit": {"$ref": "#/$defs/git_oid"},
          "tested_tree": {"$ref": "#/$defs/git_oid"},
          "source_tree_listing_sha256": {"$ref": "#/$defs/sha256"},
          "test_run_provenance_sha256": {"$ref": "#/$defs/sha256"},
          "test_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "external_evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "sha256"],
              "properties": {
                "label": {"$ref": "#/$defs/safe_name"},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          },
          "totals": {"$ref": "#/$defs/totals"}
        }
      }
    },
    "aggregate": {"$ref": "#/$defs/totals"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "safe_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "safe_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending_total", "unknown_total", "failed_total"],
      "properties": {
        "pending_total": {"type": "integer", "minimum": 0},
        "unknown_total": {"type": "integer", "minimum": 0},
        "failed_total": {"type": "integer", "minimum": 0}
      }
    },
    "test_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "skip", "total"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "skip": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    "stat_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "uid", "gid", "mode", "nlink", "size", "mtime_ns", "ctime_ns"],
      "properties": {
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
        "nlink": {"type": "integer", "minimum": 1},
        "size": {"type": "integer", "minimum": 0},
        "mtime_ns": {"type": "integer", "minimum": 0},
        "ctime_ns": {"type": "integer", "minimum": 0}
      }
    },
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "stat"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "stat": {"$ref": "#/$defs/stat_identity"}
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "git_mode", "git_object", "sha256", "size"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "type": {"enum": ["regular", "symlink"]},
        "git_mode": {"enum": ["100644", "100755", "120000"]},
        "git_object": {"$ref": "#/$defs/git_oid"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "tool_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "requested_path", "resolved_path", "binary", "shebang", "version_argv", "stdout", "stderr"],
      "properties": {
        "name": {"$ref": "#/$defs/safe_name"},
        "requested_path": {"type": "string", "pattern": "^/"},
        "resolved_path": {"type": "string", "pattern": "^/"},
        "binary": {"$ref": "#/$defs/file_identity"},
        "shebang": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["line", "argv", "requested_path", "resolved_path", "binary"],
          "properties": {
            "line": {"type": "string", "minLength": 1},
            "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "requested_path": {"type": "string", "pattern": "^/"},
            "resolved_path": {"type": "string", "pattern": "^/"},
            "binary": {"$ref": "#/$defs/file_identity"}
          }
        },
        "version_argv": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "stdout": {"type": "object", "additionalProperties": false, "required": ["text", "sha256"], "properties": {"text": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
        "stderr": {"type": "object", "additionalProperties": false, "required": ["text", "sha256"], "properties": {"text": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "tree_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "stat"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "type": {"enum": ["directory", "regular"]},
        "stat": {"$ref": "#/$defs/stat_identity"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
